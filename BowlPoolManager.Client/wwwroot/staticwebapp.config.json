{
    "platform": {
        "apiRuntime": "dotnet-isolated:10.0"
    },
    "navigationFallback": {
        "rewrite": "/index.html"
    },
    "routes": [
        {
            "route": "/admin/*",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/logout",
            "rewrite": "/.auth/logout"
        }
    ],
    "responseOverrides": {
        "401": {
            "redirect": "/login"
        }
    }
}
