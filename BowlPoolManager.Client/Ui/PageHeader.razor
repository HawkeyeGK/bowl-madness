<PageTitle>@(DocumentTitle ?? Title)</PageTitle>

<div class="bm-pageheader">
    <div class="bm-pageheader-row">
        <div class="bm-pageheader-text">
            <h1 class="bm-h1" tabindex="-1">@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <div class="bm-subtitle">@Subtitle</div>
            }
        </div>
        @if (Actions != null)
        {
            <div class="bm-pageheader-actions">@Actions</div>
        }
    </div>
    <StatusLine Text="@Status" Tone="@StatusTone" Icon="@StatusIcon" />
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>The browser tab title when it should differ from <see cref="Title"/>.</summary>
    [Parameter] public string? DocumentTitle { get; set; }
    /// <summary>A line under the title, for example the pool name.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>The status line text (build it with <c>StatusLineText</c> in Core). Nothing is drawn when empty.</summary>
    [Parameter] public string? Status { get; set; }
    [Parameter] public StatusTone StatusTone { get; set; }
    [Parameter] public string? StatusIcon { get; set; }
    /// <summary>Buttons at the right of the title (print, pool switcher).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
