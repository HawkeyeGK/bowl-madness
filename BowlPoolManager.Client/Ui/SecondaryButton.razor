@inherits AppButtonBase

@* Any other action (white with a thin border). *@
<MudButton Class="@CssFor("secondary")" Variant="Variant.Filled" Href="@LinkHref" OnClick="ClickHandler" Disabled="Disabled"
           FullWidth="FullWidth" ButtonType="ButtonType" StartIcon="@(IconOnly ? null : Icon)" aria-label="@AriaLabel">
    @if (IconOnly && !string.IsNullOrEmpty(Icon))
    {
        <MudIcon Icon="@Icon" />
        <span class="bm-sr-only">@ChildContent</span>
    }
    else
    {
        @ChildContent
    }
</MudButton>
