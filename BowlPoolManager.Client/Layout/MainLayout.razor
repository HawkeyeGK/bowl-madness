@inherits LayoutComponentBase
@implements IDisposable
@using BowlPoolManager.Core.Domain
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using BowlPoolManager.Core.Helpers
@using BowlPoolManager.Client.Theme
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISiteContext SiteContext
@inject BowlPoolManager.Client.Services.AppState AppState

<MudThemeProvider Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="bm-shell">
    <AppHeader Sport="SiteContext.ActiveSport" NeedsPicks="needsPicks" />

    <main class="bm-main">
        @* One width rule for the whole site (see PageWidth in Core): header width everywhere, full width only for big grids. *@
        <article class="@(isWidePage ? "bm-article bm-article--wide" : "bm-article")">
            @Body
        </article>
    </main>

    <BottomNav Items="SiteNavigation.Tabs(SiteContext.ActiveSport, needsPicks)" LiveKeys="liveKeys" />

    @* GLOBAL SECURITY TOAST *@
    @if (showSecurityToast)
    {
        <div style="position: fixed; top: 12px; left: 12px; right: 12px; z-index: 2000; max-width: 560px; margin: 0 auto">
            <Notice Tone="NoticeTone.Error">@securityMessage</Notice>
        </div>
    }
</div>

@code {
    private bool showSecurityToast = false;
    private string securityMessage = "";
    private readonly HashSet<string> liveKeys = new();
    // True when the player has no entry yet (or is signed out): the picks tab then says "Enter Picks".
    private bool needsPicks;
    private bool isWidePage;

    protected override async Task OnInitializedAsync()
    {
        // Width first, before any await, so the first render already has the right width (no jump on a direct load).
        isWidePage = PageWidth.IsWide(Nav.ToBaseRelativePath(Nav.Uri));
        Nav.LocationChanged += OnLocationChanged;

        await SiteContext.InitializeAsync();
        SiteContext.OnChange += OnSiteContextChanged;
        AppState.OnChange += OnAppStateChanged;

        await CheckDisabledAccountAsync();
        await CheckLiveStatusAsync();
        await UpdateNeedsPicksAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isWidePage = PageWidth.IsWide(Nav.ToBaseRelativePath(e.Location));
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSiteContextChanged() => _ = InvokeAsync(async () =>
    {
        await UpdateNeedsPicksAsync();
        StateHasChanged();
    });

    // A page raises this after the player saves or deletes an entry.
    private void OnAppStateChanged() => _ = InvokeAsync(async () =>
    {
        await UpdateNeedsPicksAsync();
        StateHasChanged();
    });

    private async Task UpdateNeedsPicksAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                needsPicks = true;
                return;
            }

            var url = SiteContext.ActiveSport == Sport.Basketball ? "api/GetMyHoopsEntries" : "api/GetMyEntries";
            var entries = await Http.GetFromJsonAsync<List<BracketEntry>>(url);
            needsPicks = entries == null || entries.Count == 0;
        }
        catch
        {
            // If the check fails, show the usual "My Picks" rather than a wrong prompt.
            needsPicks = false;
        }
    }

    private async Task CheckDisabledAccountAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;

            // Only check if they are actually logged in
            if (userPrincipal.Identity?.IsAuthenticated == true)
            {
                // Verify against our DB (The "Bouncer" Check)
                // We use GetMe to silently fetch the full profile
                var userProfile = await Http.GetFromJsonAsync<UserProfile>("api/GetMe");

                if (userProfile != null && userProfile.IsDisabled)
                {
                    await ShowDisabledAndSignOutAsync();
                }
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            // The server answers GetMe with 403 for a disabled account (issue 98).
            await ShowDisabledAndSignOutAsync();
        }
        catch (Exception ex)
        {
            // Fail open effectively, or log silently.
            // If the API is down, we don't want to boot legitimate users,
            // but we also can't check for bans.
            Console.WriteLine($"Auth Check Failed: {ex.Message}");
        }
    }

    /// <summary>A red dot on the Scores tab while any football game is being played (as the old menu's LIVE badge did).</summary>
    private async Task CheckLiveStatusAsync()
    {
        try
        {
            var games = await Http.GetFromJsonAsync<List<BowlGame>>("api/GetGames");
            if (games != null && games.Any(g => g.Status == GameStatus.InProgress))
            {
                liveKeys.Add("scores");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Live status check failed: {ex.Message}");
        }
    }

    private async Task ShowDisabledAndSignOutAsync()
    {
        // 1. Show Red Card
        securityMessage = "Access Denied: Your account has been disabled.";
        showSecurityToast = true;
        StateHasChanged();

        // 2. Wait for them to read it
        await Task.Delay(3000);

        // 3. Eject (Force Logout)
        Nav.NavigateTo("/.auth/logout?post_logout_redirect_uri=/", forceLoad: true);
    }

    public void Dispose()
    {
        SiteContext.OnChange -= OnSiteContextChanged;
        AppState.OnChange -= OnAppStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
