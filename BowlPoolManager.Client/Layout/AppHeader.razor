@using Microsoft.AspNetCore.Components.Authorization
@using BowlPoolManager.Core.Domain
@using MudBlazor
@using BowlPoolManager.Client.Ui
@inject NavigationManager Nav

<header class="bm-header no-print">
    <div class="bm-header-bar">
        <a class="bm-brand" href="@HomeHref">@SiteNavigation.SiteName(Sport)</a>

        @* Wide screens: the four main links, then History and Print Bracket, then Admin for admins. *@
        <nav class="bm-topnav bm-only-wide" aria-label="Main">
            @foreach (var item in SiteNavigation.Tabs(Sport, NeedsPicks).Concat(SiteNavigation.MenuLinks(Sport)))
            {
                <NavLink href="@item.Href" Match="@(item.MatchExact ? NavLinkMatch.All : NavLinkMatch.Prefix)">@item.Label</NavLink>
            }
            <AuthorizeView Roles="SuperAdmin,Admin">
                <NavLink href="admin/dashboard">Admin</NavLink>
            </AuthorizeView>
        </nav>

        <div class="bm-spacer"></div>

        <AuthorizeView>
            <Authorized>
                <span class="bm-header-hello bm-only-wide" title="@context.User.Identity?.Name">Hello, <strong>@context.User.Identity?.Name</strong></span>
                @* Not a plain link: Blazor would route "/.auth/..." inside the app ("Page not found"); the browser must load it. *@
                <a class="bm-header-link bm-only-wide" href="@LogoutHref" @onclick="LogOut" @onclick:preventDefault="true">Log out</a>
            </Authorized>
            <NotAuthorized>
                <a class="bm-header-link" href="login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>

        @* Phones: the four tabs are in the bottom bar; everything else is here. *@
        <MudMenu Class="bm-only-phone" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent Context="menu">
                <button type="button" class="bm-menu-button" aria-label="Open the menu" aria-haspopup="menu" @onclick="menu.ToggleAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Menu" />
                </button>
            </ActivatorContent>
            <ChildContent>
                <AuthorizeView>
                    <Authorized>
                        <div class="bm-note" style="padding: 8px 16px">Signed in as <strong>@context.User.Identity?.Name</strong></div>
                    </Authorized>
                </AuthorizeView>
                @foreach (var item in SiteNavigation.MenuLinks(Sport))
                {
                    <MudMenuItem Href="@item.Href" Icon="@NavIcons.For(item.Key)">@item.Label</MudMenuItem>
                }
                <AuthorizeView Roles="SuperAdmin,Admin">
                    <MudMenuItem Href="admin/dashboard" Icon="@NavIcons.For("admin")">Admin</MudMenuItem>
                </AuthorizeView>
                <MudDivider />
                <AuthorizeView>
                    <Authorized>
                        <MudMenuItem Href="@LogoutHref" ForceLoad="true" Icon="@Icons.Material.Outlined.Logout">Log out</MudMenuItem>
                    </Authorized>
                    <NotAuthorized>
                        <MudMenuItem Href="login" Icon="@Icons.Material.Outlined.Login">Sign in</MudMenuItem>
                    </NotAuthorized>
                </AuthorizeView>
            </ChildContent>
        </MudMenu>
    </div>

    @* Phones: the pool tabs sit inside the navy header, only on pages that use pools. *@
    <PoolSwitcher Mode="PoolSwitcherMode.HeaderTabs" />
</header>

@code {
    [Parameter] public Sport Sport { get; set; }
    /// <summary>True when the player has no entry yet: the picks link says "Enter Picks".</summary>
    [Parameter] public bool NeedsPicks { get; set; }

    private const string LogoutHref = "/.auth/logout?post_logout_redirect_uri=/";

    private void LogOut() => Nav.NavigateTo(LogoutHref, forceLoad: true);

    private string HomeHref => SiteNavigation.Tabs(Sport)[0].Href;
}
