@page "/print-bracket"
@layout BowlPoolManager.Client.Layout.PrintLayout
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core.Helpers
@using BowlPoolManager.Client.Services
@using MudBlazor
@using BowlPoolManager.Client.Ui
@inject ISeasonService SeasonService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Blank Entry Form</PageTitle>

@*
    The blank entry form (Release 2 group D, prototype 5b): one landscape letter page, always.
    Black and white. What goes on it is decided in Core (PrintFormText, BlankFormSlots, PlayoffColumns);
    this page only draws. Single entries print from PrintBracket (/print-bracket/{id}).
*@

@if (!loaded)
{
    <div class="blank-loading">Loading the form...</div>
}
else if (currentPool == null)
{
    <div class="blank-loading">There is no open pool to print yet.</div>
}
else
{
    <div class="blank-toolbar no-print">
        @if (pools.Count > 1)
        {
            <select class="blank-select" aria-label="Pool" @onchange="OnPoolChanged">
                @foreach (var pool in pools)
                {
                    <option value="@pool.Id" selected="@(pool.Id == currentPool.Id)">@pool.Name</option>
                }
            </select>
        }
        <PrimaryButton Icon="@Icons.Material.Filled.Print" OnClick="PrintPage">Print (landscape letter)</PrimaryButton>
        <SecondaryButton Href="/">Back to the Leaderboard</SecondaryButton>
    </div>

    <div class="sheet" style="--bowl-rows: @BowlRows; --bowl-font: @(BlankFormSizing.TeamFontPx(BowlRows))px">
        <header class="sheet-head">
            <div class="fill-ins">
                <div class="fill"><span>Name</span><i></i></div>
                <div class="fill"><span>Email</span><i></i></div>
                <div class="fill short"><span>Bracket name</span><i></i></div>
            </div>
            <div class="title">
                <h1>@titleText</h1>
                <div>@currentPool.Name &middot; Bowl-Madness.com</div>
            </div>
        </header>

        <section class="bowls" aria-label="Bowl games">
            @foreach (var game in standardGames)
            {
                <div class="bowl">
                    <div class="bowl-top"><b>@game.BowlName</b><span>@Short(game)</span></div>
                    <div class="side"><u></u>@game.TeamAway</div>
                    <div class="side"><u></u>@game.TeamHome</div>
                </div>
            }
        </section>

        <section class="tree" aria-label="Playoff">
            <div class="col">
                <h2>First round</h2>
                <div class="col-games">@foreach (var g in columns.FirstRound) { @Card(g) }</div>
            </div>
            <div class="col">
                <h2>Quarterfinals</h2>
                <div class="col-games">@foreach (var g in columns.Quarterfinals) { @Card(g) }</div>
            </div>
            <div class="col">
                <h2>Semifinals</h2>
                <div class="col-games">@foreach (var g in columns.SemiFinals) { @Card(g) }</div>
            </div>
            <div class="col">
                <h2>Championship</h2>
                <div class="col-games">
                    @foreach (var g in columns.Championship)
                    {
                        @Card(g)
                        <div class="champion"><b>CHAMPION</b><i></i></div>
                    }
                </div>
            </div>
        </section>

        <footer class="sheet-foot">
            <div class="rules">
                <b>Bowls:</b> circle the winner (@PointText(false) each).
                <b>Playoffs:</b> write the winner of each game on a line in the next round.
                <b>Points:</b> first round @PointText(true, TournamentRound.Round1), quarterfinals @PointText(true, TournamentRound.QuarterFinal),
                semifinals @PointText(true, TournamentRound.SemiFinal), championship @PointText(true, TournamentRound.Championship).
            </div>
            @if (tieBreakerLine != null)
            {
                <div class="tiebreak"><b>@tieBreakerLine</b><i></i></div>
            }
        </footer>
    </div>
}

@code {
    private RenderFragment Card(BowlGame game) => __builder =>
    {
        var slots = BlankFormSlots.SlotsFor(game, poolGames);
        <div class="card">
            <div class="bowl-top"><b>@(game.Round == TournamentRound.Championship ? "Championship" : game.BowlName)</b><span>@Short(game)</span></div>
            <div class="side">@SlotText(slots.Top)</div>
            <div class="side">@SlotText(slots.Bottom)</div>
        </div>
    };

    private static RenderFragment SlotText(string? name) => __builder =>
    {
        if (name == null)
        {
            <u class="blank"></u>
        }
        else
        {
            <u></u>@name
        }
    };

    [SupplyParameterFromQuery(Name = "poolId")] public string? QueryPoolId { get; set; }

    private bool loaded;
    private List<BowlPool> pools = new();
    private List<BowlGame> allSeasonGames = new();
    private Season? season;
    private BowlPool? currentPool;
    private List<BowlGame> poolGames = new();
    private List<BowlGame> standardGames = new();
    private PlayoffColumns columns = new();
    private string titleText = "BOWL MADNESS";
    private string? tieBreakerLine;

    private int BowlRows => BlankFormSizing.Rows(standardGames.Count);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            season = await SeasonService.GetCurrentSeasonAsync();
            var seasonId = season?.Id ?? "";
            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>($"api/GetPools?seasonId={seasonId}");
            var gamesTask = Http.GetFromJsonAsync<List<BowlGame>>($"api/GetGames?seasonId={seasonId}");
            await Task.WhenAll(poolsTask, gamesTask);
            pools = (await poolsTask ?? new()).Where(p => !p.IsArchived).ToList();
            allSeasonGames = await gamesTask ?? new();

            currentPool = pools.FirstOrDefault(p => p.Id == QueryPoolId);
            if (currentPool == null)
            {
                try
                {
                    var saved = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "lastSelectedPoolId");
                    currentPool = pools.FirstOrDefault(p => p.Id == saved);
                }
                catch { /* storage may be unavailable */ }
            }
            currentPool ??= pools.FirstOrDefault();
            Prepare();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        loaded = true;
    }

    private async Task OnPoolChanged(ChangeEventArgs e)
    {
        currentPool = pools.FirstOrDefault(p => p.Id == e.Value?.ToString());
        if (currentPool == null) return;
        try { await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastSelectedPoolId", currentPool.Id); } catch { }
        Prepare();
    }

    private void Prepare()
    {
        if (currentPool == null) return;

        poolGames = (currentPool.GameIds != null && currentPool.GameIds.Any()
                ? allSeasonGames.Where(g => currentPool.GameIds.Contains(g.Id))
                : allSeasonGames)
            .Where(g => g.SeasonId == currentPool.SeasonId)
            .ToList();

        // The shared order (same as fast paper entry); regular bowls come first in it.
        standardGames = GameOrder.ForEntry(poolGames).Where(g => !g.IsPlayoff).ToList();
        columns = PlayoffColumns.Build(poolGames);
        titleText = PrintFormText.Title("BOWL MADNESS", currentPool, season);
        tieBreakerLine = PrintFormText.TieBreakerLine(currentPool, poolGames);
    }

    private Task PrintPage() => JSRuntime.InvokeVoidAsync("window.print").AsTask();

    private static string Short(BowlGame g) => DateTimeHelper.ToCentralLabel(g.StartTime, "MMM d h:mm tt");

    private string PointText(bool playoff, TournamentRound? round = null)
    {
        var sample = playoff
            ? poolGames.FirstOrDefault(g => g.IsPlayoff && g.Round == round)
            : poolGames.FirstOrDefault(g => !g.IsPlayoff);
        return sample == null ? "-" : $"{sample.PointValue} pt" + (sample.PointValue == 1 ? "" : "s");
    }
}
