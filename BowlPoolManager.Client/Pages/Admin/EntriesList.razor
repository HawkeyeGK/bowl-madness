@page "/admin/entries"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core

@using BowlPoolManager.Client.Services
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Net.Http.Json
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISeasonService SeasonService

@* Release 2 group C: the admin entries list. Shows season and pool names, never season ids. Edit opens the entry form, where Move Entry lives. *@

<PageContainer>
    <PageHeader Title="Manage entries" Subtitle="@($"Showing {filteredEntries.Count} {(filteredEntries.Count == 1 ? "entry" : "entries")}")">
        <Actions>
            <PrimaryButton Href="/admin/entry" Icon="@Icons.Material.Outlined.Add">New entry</PrimaryButton>
        </Actions>
    </PageHeader>

    <Card Tone="CardTone.Outlined">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudSelect T="string" Value="selectedSeasonId" ValueChanged="OnSeasonFilterChanged" Label="Season" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("")">All seasons</MudSelectItem>
                    @foreach (var s in seasons)
                    {
                        <MudSelectItem T="string" Value="@s.Id">@s.Name@(s.IsCurrent ? " (current)" : "")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" Value="selectedPoolId" ValueChanged="OnPoolFilterChanged" Label="Pool" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("")">All pools</MudSelectItem>
                    @foreach (var pool in FilteredPoolOptions)
                    {
                        <MudSelectItem T="string" Value="@pool.Id">@(string.IsNullOrEmpty(selectedSeasonId) ? $"{SeasonName(pool.SeasonId)}: " : "")@pool.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </Card>

    @if (isLoading)
    {
        <LoadingIndicator Text="Loading entries..." />
    }
    else if (filteredEntries.Count == 0)
    {
        <EmptyState Title="No entries found" Icon="@Icons.Material.Outlined.Inbox">
            <ChildContent>No entries match these filters.</ChildContent>
        </EmptyState>
    }
    else
    {
        <DataTable Label="Entries">
            <TableHeader Columns="@PhoneColumns" ColumnsWide="@WideColumns">
                <TableHeaderCell Text="Bracket" />
                <TableHeaderCell Text="Owner" HidePhone="true" />
                <TableHeaderCell Text="Pool" HidePhone="true" />
                <TableHeaderCell Text="Season" HidePhone="true" />
                <TableHeaderCell Text="Tiebreaker" End="true" HidePhone="true" />
                <TableHeaderCell Text="Created" HidePhone="true" />
                <TableHeaderCell Text="Actions" End="true" />
            </TableHeader>
            @foreach (var entry in filteredEntries)
            {
                var poolName = pools.FirstOrDefault(p => p.Id == entry.PoolId)?.Name ?? "Unknown pool";
                <TableRow Columns="@PhoneColumns" ColumnsWide="@WideColumns">
                    <TableCell Kind="CellKind.Name">
                        <span>@entry.PlayerName</span>
                        <span class="bm-only-phone"><Badge>@poolName</Badge></span>
                    </TableCell>
                    <TableCell HidePhone="true">
                        @if (userEmailMap.TryGetValue(entry.UserId, out var email))
                        {
                            <a href="mailto:@email">@email</a>
                        }
                        else if (!string.IsNullOrWhiteSpace(entry.OwnerName))
                        {
                            <span>@entry.OwnerName</span> <span class="bm-note">(no account)</span>
                        }
                        else
                        {
                            <span class="bm-note">Admin entered</span>
                        }
                    </TableCell>
                    <TableCell HidePhone="true">@poolName</TableCell>
                    <TableCell HidePhone="true">@SeasonName(entry.SeasonId)</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@entry.TieBreakerPoints</TableCell>
                    <TableCell Kind="CellKind.Muted" HidePhone="true">@DateTimeHelper.ToCentralLabel(entry.CreatedOn, "MMM d yyyy, h:mm tt")</TableCell>
                    <TableCell End="true">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            <SecondaryButton Href="@($"/admin/entry/{entry.Id}?seasonId={entry.SeasonId}")" Icon="@Icons.Material.Outlined.Edit" IconOnly="true" AriaLabel="@($"Edit {entry.PlayerName}")">Edit</SecondaryButton>
                            <SecondaryButton Icon="@Icons.Material.Outlined.DeleteOutline" IconOnly="true" AriaLabel="@($"Delete {entry.PlayerName}")" OnClick="@(() => DeleteEntry(entry))">Delete</SecondaryButton>
                        </MudStack>
                    </TableCell>
                </TableRow>
            }
        </DataTable>
    }
</PageContainer>

@code {
    // Phone: name (with the pool) and the buttons. Wide screens add owner, pool, season, tiebreaker and created.
    private const string PhoneColumns = "minmax(0, 1fr) 112px";
    private const string WideColumns = "minmax(160px, 1.4fr) minmax(160px, 1.4fr) minmax(120px, 1fr) 90px 90px 150px 112px";

    private List<BracketEntry> allEntries = new();
    private List<BracketEntry> filteredEntries = new();
    private List<BowlPool> pools = new();
    private List<Season> seasons = new();
    private Dictionary<string, string> userEmailMap = new();
    private bool isLoading = true;
    
    private string selectedSeasonId = "";
    private string selectedPoolId = "";
    
    // Derived property for Pool dropdown options
    private IEnumerable<BowlPool> FilteredPoolOptions => 
        string.IsNullOrEmpty(selectedSeasonId) 
            ? pools 
            : pools.Where(p => p.SeasonId == selectedSeasonId);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            
            var seasonsTask = SeasonService.GetSeasonsAsync();
            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>("api/GetPools");
            // Target standard entry point which gets ALL entries across all pools/seasons
            var entriesTask = Http.GetFromJsonAsync<List<BracketEntry>>("api/GetEntries"); 
            var usersTask = Http.GetFromJsonAsync<List<UserProfile>>("api/GetUsers");

            await Task.WhenAll(seasonsTask, poolsTask, entriesTask, usersTask);

            seasons = await seasonsTask ?? new();
            pools = await poolsTask ?? new();
            allEntries = await entriesTask ?? new();
            var users = await usersTask ?? new();
            
            userEmailMap = users.ToDictionary(u => u.Id, u => u.Email);
            
            allEntries = allEntries.OrderByDescending(e => e.CreatedOn).ToList();
            
            // Set Default Season
            var currentSeason = seasons.FirstOrDefault(s => s.IsCurrent);
            if (currentSeason != null)
            {
                selectedSeasonId = currentSeason.Id;
            }
            
            FilterData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private string SeasonName(string seasonId) =>
        seasons.FirstOrDefault(s => s.Id == seasonId)?.Name ?? seasonId;

    private void OnSeasonFilterChanged(string seasonId)
    {
        selectedSeasonId = seasonId ?? "";
        // Reset pool selection when season changes, as the pool might not exist in the new season scope
        selectedPoolId = ""; 
        FilterData();
    }
    
    private void OnPoolFilterChanged(string poolId)
    {
        selectedPoolId = poolId ?? "";
        FilterData();
    }
    
    private void FilterData()
    {
        var query = allEntries.AsQueryable();
        
        if (!string.IsNullOrEmpty(selectedSeasonId))
        {
            query = query.Where(e => e.SeasonId == selectedSeasonId);
        }
        
        if (!string.IsNullOrEmpty(selectedPoolId))
        {
            query = query.Where(e => e.PoolId == selectedPoolId);
        }
        
        filteredEntries = query.ToList();
    }

    private async Task DeleteEntry(BracketEntry entry)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the bracket for '{entry.PlayerName}'?");
        if (confirmed)
        {
            var response = await Http.DeleteAsync($"api/DeleteEntry/{entry.Id}?seasonId={entry.SeasonId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Failed to delete entry.");
            }
        }
    }
}
