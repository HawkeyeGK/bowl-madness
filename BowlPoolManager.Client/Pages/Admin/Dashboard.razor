@page "/admin/dashboard"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization

@* Each site shows its own sport's tiles: Football Admin on bowl-madness, Hoops Admin on hoops-madness, both on any other host (DashboardSports, Core).
   Site Admin and Utilities serve both sports and show on both sites, except Score Feed, which is the football mock feed. *@

<PageTitle>Admin Dashboard</PageTitle>

<div class="container-fluid mt-3 px-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-0"><i class="bi bi-speedometer2 text-primary"></i> Admin Dashboard</h1>
    </div>

    @* ===== SITE ADMIN ===== *@
    <AuthorizeView Roles="SuperAdmin" Context="sa">
        <div class="mb-2">
            <span class="text-uppercase fw-bold small text-muted">
                <i class="bi bi-gear-fill me-1"></i> Site Admin
            </span>
            <hr class="mt-1 mb-3" />
        </div>
        <div class="row g-4 mb-5">

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-person-badge display-4 text-info mb-3"></i>
                        <h5 class="card-title">Users</h5>
                        <p class="card-text text-muted small">Manage roles &amp; access.</p>
                        <a href="admin/users" class="btn btn-outline-info stretched-link">Manage Users</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-range display-4 mb-3" style="color: #6f42c1;"></i>
                        <h5 class="card-title">Seasons</h5>
                        <p class="card-text text-muted small">Manage active years.</p>
                        <a href="admin/seasons" class="btn btn-outline-primary stretched-link" style="border-color: #6f42c1; color: #6f42c1;">Manage Seasons</a>
                    </div>
                </div>
            </div>

        </div>
    </AuthorizeView>

    @* ===== FOOTBALL ADMIN ===== *@
    @if (sports.Football)
    {
    <div class="mb-2">
        <span class="text-uppercase fw-bold small text-muted">
            <i class="bi bi-trophy-fill me-1"></i> Football Admin
        </span>
        <hr class="mt-1 mb-3" />
    </div>
    <div class="row g-4 mb-5">

        <AuthorizeView Roles="SuperAdmin" Context="fa">

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-list-check display-4 text-primary mb-3"></i>
                        <h5 class="card-title">Season Setup</h5>
                        <p class="card-text text-muted small">Setup steps in order, and what is done.</p>
                        <a href="admin/season-setup" class="btn btn-outline-primary stretched-link">Season Setup</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-collection-play display-4 text-secondary mb-3"></i>
                        <h5 class="card-title">Bowl Pools</h5>
                        <p class="card-text text-muted small">Lock dates &amp; invite codes.</p>
                        <a href="admin/pools" class="btn btn-outline-secondary stretched-link">Bowl Pools</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-event display-4 text-success mb-3"></i>
                        <h5 class="card-title">Bowl Games</h5>
                        <p class="card-text text-muted small">Schedules &amp; metadata.</p>
                        <a href="admin/games" class="btn btn-outline-success stretched-link">Bowl Games</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-link-45deg display-4 text-dark mb-3"></i>
                        <h5 class="card-title">Link Bowl Games</h5>
                        <p class="card-text text-muted small">Connect API feeds.</p>
                        <a href="admin/linker" class="btn btn-outline-dark stretched-link">Link Bowl Games</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-trophy-fill display-4 text-danger mb-3"></i>
                        <h5 class="card-title">Bowl Game Results</h5>
                        <p class="card-text text-muted small">Enter scores &amp; winners.</p>
                        <a href="admin/gameresults" class="btn btn-outline-danger stretched-link">Bowl Game Results</a>
                    </div>
                </div>
            </div>

        </AuthorizeView>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-people display-4 text-primary mb-3"></i>
                    <h5 class="card-title">Bowl Pool Entries</h5>
                    <p class="card-text text-muted small">Manage player brackets.</p>
                    <a href="admin/entries" class="btn btn-outline-primary stretched-link">Bowl Pool Entries</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-cash-coin display-4 text-warning mb-3"></i>
                    <h5 class="card-title">Bowl Pool Payments</h5>
                    <p class="card-text text-muted small">Track manual payments.</p>
                    <a href="admin/payments" class="btn btn-outline-warning stretched-link">Bowl Pool Payments</a>
                </div>
            </div>
        </div>

    </div>
    }

    @* ===== HOOPS ADMIN ===== *@
    @if (sports.Hoops)
    {
    <AuthorizeView Roles="SuperAdmin,Admin" Context="ha">
        <div class="mb-2">
            <span class="text-uppercase fw-bold small text-muted">
                <i class="bi bi-dribbble me-1"></i> Hoops Admin
            </span>
            <hr class="mt-1 mb-3" />
        </div>
        <div class="row g-4 mb-5">

            <AuthorizeView Roles="SuperAdmin" Context="haSuperAdmin">

                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <i class="bi bi-collection-play display-4 text-secondary mb-3"></i>
                            <h5 class="card-title">Hoops Pools</h5>
                            <p class="card-text text-muted small">Basketball pool settings &amp; scoring.</p>
                            <a href="admin/hoops-pools" class="btn btn-outline-secondary stretched-link">Hoops Pools</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <i class="bi bi-diagram-3-fill display-4 text-success mb-3"></i>
                            <h5 class="card-title">Bracket Builder</h5>
                            <p class="card-text text-muted small">Generate &amp; verify bracket structure.</p>
                            <a href="admin/tournament-config" class="btn btn-outline-success stretched-link">Bracket Builder</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <i class="bi bi-person-fill-check display-4 text-primary mb-3"></i>
                            <h5 class="card-title">Bracket Teams</h5>
                            <p class="card-text text-muted small">Assign teams &amp; seeds to bracket slots.</p>
                            <a href="admin/team-assignment" class="btn btn-outline-primary stretched-link">Bracket Teams</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <i class="bi bi-clock-history display-4 text-secondary mb-3"></i>
                            <h5 class="card-title">Bracket Archives</h5>
                            <p class="card-text text-muted small">View concluded basketball pool history.</p>
                            <a href="hoops/archives" class="btn btn-outline-secondary stretched-link">Bracket Archives</a>
                        </div>
                    </div>
                </div>

            </AuthorizeView>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-trophy-fill display-4 text-danger mb-3"></i>
                        <h5 class="card-title">Bracket Game Results</h5>
                        <p class="card-text text-muted small">Enter scores &amp; winners.</p>
                        <a href="admin/hoops/gameresults" class="btn btn-outline-danger stretched-link">Bracket Game Results</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-people display-4 text-info mb-3"></i>
                        <h5 class="card-title">Bracket Entries</h5>
                        <p class="card-text text-muted small">Manage basketball player brackets.</p>
                        <a href="admin/hoops/entries" class="btn btn-outline-info stretched-link">Bracket Entries</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-cash-coin display-4 text-warning mb-3"></i>
                        <h5 class="card-title">Bracket Payments</h5>
                        <p class="card-text text-muted small">Track basketball pool payments.</p>
                        <a href="admin/hoops/payments" class="btn btn-outline-warning stretched-link">Bracket Payments</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-link-45deg display-4 text-primary mb-3"></i>
                        <h5 class="card-title">Game Linker</h5>
                        <p class="card-text text-muted small">Link bracket games to live score data.</p>
                        <a href="admin/hoops/gamelinker" class="btn btn-outline-primary stretched-link">Game Linker</a>
                    </div>
                </div>
            </div>

        </div>
    </AuthorizeView>
    }

    @* ===== UTILITIES ===== *@
    <AuthorizeView Roles="SuperAdmin,Admin" Context="util">
        <div class="mb-2">
            <span class="text-uppercase fw-bold small text-muted">
                <i class="bi bi-tools me-1"></i> Utilities
            </span>
            <hr class="mt-1 mb-3" />
        </div>
        <div class="row g-4 mb-4">

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-palette display-4 text-secondary mb-3"></i>
                        <h5 class="card-title">Component Sheet</h5>
                        <p class="card-text text-muted small">Every shared building block of the new look.</p>
                        <a href="admin/components" class="btn btn-outline-secondary stretched-link">Component Sheet</a>
                    </div>
                </div>
            </div>

            <AuthorizeView Roles="SuperAdmin" Context="utilSuperAdmin">

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-cloud-arrow-down-fill display-4 text-info mb-3"></i>
                        <h5 class="card-title">API Integrations</h5>
                        <p class="card-text text-muted small">Manage API sync &amp; status.</p>
                        <a href="admin/api-manager" class="btn btn-outline-info stretched-link">Manage Integrations</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-cloud-download display-4 text-dark mb-3"></i>
                        <h5 class="card-title">Backup Data</h5>
                        <p class="card-text text-muted small">Download full season JSON.</p>
                        <a href="/api/GetBackupData" target="_blank" class="btn btn-outline-dark stretched-link">Download Backup</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-arrow-repeat display-4 text-warning mb-3"></i>
                        <h5 class="card-title">Migration Utility</h5>
                        <p class="card-text text-muted small">Migrate legacy pools.</p>
                        <a href="admin/migration" class="btn btn-outline-warning stretched-link">Manage Migration</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-hdd-network display-4 text-danger mb-3"></i>
                        <h5 class="card-title">System Maintenance</h5>
                        <p class="card-text text-muted small">Initialize database resources.</p>
                        <a href="admin/maintenance" class="btn btn-outline-danger stretched-link">System Maintenance</a>
                    </div>
                </div>
            </div>

            @if (sports.Football)
            {
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-broadcast display-4 text-warning mb-3"></i>
                        <h5 class="card-title">Score Feed</h5>
                        <p class="card-text text-muted small">Set game scores and status for the mock feed.</p>
                        <a href="admin/score-feed" class="btn btn-outline-warning stretched-link">Score Feed</a>
                    </div>
                </div>
            </div>
            }

            @if (showTestData)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <i class="bi bi-database-gear display-4 text-warning mb-3"></i>
                            <h5 class="card-title">Test Data</h5>
                            <p class="card-text text-muted small">Reset and load a test scenario.</p>
                            <a href="admin/test-data" class="btn btn-outline-warning stretched-link">Test Data</a>
                        </div>
                    </div>
                </div>
            }

            </AuthorizeView>

        </div>
    </AuthorizeView>

</div>

@code {
    private bool showTestData;
    private DashboardSports sports => DashboardSports.ForHost(new Uri(Nav.Uri).Host);

    // The Test Data tile shows only when the API says this is the test site (SuperAdmin only).
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.IsInRole("SuperAdmin")) return;

        try
        {
            var response = await Http.GetAsync("api/TestEnvironment");
            if (response.IsSuccessStatusCode)
            {
                using var doc = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                showTestData = doc.RootElement.GetProperty("isTestEnvironment").GetBoolean();
            }
        }
        catch (Exception)
        {
            showTestData = false;
        }
    }
}
