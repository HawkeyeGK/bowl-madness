@page "/admin/entry"
@page "/admin/entry/{EntryId}"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core
@using BowlPoolManager.Core.Helpers
@using BowlPoolManager.Client.Components
@using BowlPoolManager.Client.Helpers
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Net.Http.Json
@using System.Text.Json

@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject BowlPoolManager.Client.Services.ISeasonService SeasonService

@*
    Release 2 group C: the admin entry screen and fast paper entry (prototype 4).
    Games are listed in the same order as the printed blank form (GameOrder in Core). The keyer types one digit per
    game while reading down the paper: 1 = the team listed first (away), 2 = the team listed second (home), 0 = blank.
    Clicking a team in a row sets or fixes that one game. FastEntry in Core turns the digits into picks; this page only
    draws it. Every save goes through CreateEntry, which checks the caller first and requires an owner for entries an
    Admin keys (an account, or a typed name for someone who never signs in).
*@

<PageContainer>
    <PageHeader Title="@(string.IsNullOrEmpty(EntryId) ? "New paper entry" : "Edit entry")"
                Subtitle="@(pools.FirstOrDefault(p => p.Id == entry.PoolId)?.Name)">
        <Actions>
            <SecondaryButton Href="/admin/entries" Icon="@Icons.Material.Outlined.ArrowBack">Back to entries</SecondaryButton>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <LoadingIndicator Text="Loading..." />
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Notice Tone="NoticeTone.Error">@errorMessage</Notice>
        }

        <MudGrid Spacing="3">
            @* --- Left: who and what --- *@
            <MudItem xs="12" md="4">
                <MudStack Spacing="3">
                    <Card Tone="CardTone.Outlined">
                        @if (string.IsNullOrEmpty(EntryId))
                        {
                            <MudSelect T="string" Value="entry.PoolId" ValueChanged="OnPoolChanged" Label="Pool" Variant="Variant.Outlined">
                                @foreach (var p in pools.Where(p => !p.IsArchived))
                                {
                                    <MudSelectItem T="string" Value="@p.Id">@p.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudTextField Value="@(pools.FirstOrDefault(p => p.Id == entry.PoolId)?.Name ?? "Unknown")" Label="Pool" Variant="Variant.Outlined" ReadOnly="true" />
                                <SecondaryButton Icon="@Icons.Material.Outlined.SwapHoriz" OnClick="OpenMove">Move</SecondaryButton>
                            </MudStack>
                        }

                        <MudTextField @ref="nameField" @bind-Value="entry.PlayerName" Label="Entry name" Placeholder="For example Grandma Jo"
                                      Variant="Variant.Outlined" Immediate="true" />

                        <MudAutocomplete T="string" Label="Belongs to" Variant="Variant.Outlined"
                                         Value="@ownerText" ValueChanged="OnOwnerChanged"
                                         SearchFunc="SearchOwners" MaxItems="25" CoerceValue="true" CoerceText="false" Clearable="true"
                                         HelperText="Choose their account, or type their name if they never sign in." />

                        <MudNumericField T="int" @bind-Value="entry.TieBreakerPoints" Min="0" Max="999" Label="@TieBreakerText"
                                         Variant="Variant.Outlined" HideSpinButtons="true" />

                        <MudCheckBox T="bool" @bind-Value="paid" Label="Paid" Color="Color.Primary" />
                    </Card>

                    @if (showMove)
                    {
                        <Card Tone="CardTone.Highlight" Title="Move this entry to another pool">
                            <div>Pools of the same season only. Picks for games the new pool does not have are kept but do not score.</div>
                            @if (!MoveTargets.Any())
                            {
                                <Notice Tone="NoticeTone.Info">There is no other open pool in this season to move the entry to.</Notice>
                            }
                            else
                            {
                                <MudSelect T="string" Value="targetPoolId" ValueChanged="OnTargetPoolChanged" Label="New pool" Variant="Variant.Outlined">
                                    @foreach (var p in MoveTargets)
                                    {
                                        <MudSelectItem T="string" Value="@p.Id">@p.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            @if (!string.IsNullOrEmpty(targetPoolId) && targetMissingPicks > 0)
                            {
                                <Notice Tone="NoticeTone.Warning">@(targetMissingPicks == 1 ? "1 game in that pool has" : $"{targetMissingPicks} games in that pool have") no pick from this entry.</Notice>
                            }
                            @if (!string.IsNullOrEmpty(moveError))
                            {
                                <Notice Tone="NoticeTone.Error">@moveError</Notice>
                            }
                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                <PrimaryButton OnClick="ExecuteMove" Disabled="@(isMoving || string.IsNullOrEmpty(targetPoolId))">@(isMoving ? "Moving..." : "Confirm move")</PrimaryButton>
                                <SecondaryButton OnClick="CloseMove" Disabled="@isMoving">Cancel</SecondaryButton>
                            </MudStack>
                        </Card>
                    }

                    @if (!string.IsNullOrEmpty(EntryId))
                    {
                        <details>
                            <summary>Audit log</summary>
                            @if (entry.AuditLog != null && entry.AuditLog.Any())
                            {
                                <ul class="bm-note">
                                    @foreach (var log in entry.AuditLog.AsEnumerable().Reverse())
                                    {
                                        <li>@log</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="bm-note">No audit history.</div>
                            }
                        </details>
                    }
                </MudStack>
            </MudItem>

            @* --- Right: the picks --- *@
            <MudItem xs="12" md="8">
                @if (string.IsNullOrEmpty(entry.PoolId))
                {
                    <Card Tone="CardTone.Outlined">
                        <EmptyState Title="Choose a pool" Icon="@Icons.Material.Outlined.ListAlt">
                            <ChildContent>The games appear here in the order of the paper form.</ChildContent>
                        </EmptyState>
                    </Card>
                }
                else
                {
                    var matchups = EntryPickRules.Resolve(allGames, entry.Picks);
                    var missing = showCheck ? FastEntry.Missing(orderedGames, allGames, entry.Picks).Select(g => g.Id).ToHashSet() : new HashSet<string>();
                    var nextIndex = sequence.Length;

                    <Card Tone="CardTone.Outlined" Title="Picks, in the order on the paper form">
                        <PickProgress Picked="@PickedCount()" Total="@orderedGames.Count" />

                        <PickSequenceInput Value="@sequence" ValueChanged="OnSequenceChanged"
                                           Label="Fast entry: one keystroke per game, reading down the paper form. 1 = the first team listed, 2 = the second, 0 = skip (no pick, or keep a saved pick)."
                                           Help="Or click a team in any row to set or fix one pick." />

                        @if (!string.IsNullOrEmpty(clearNotice))
                        {
                            <Notice Tone="NoticeTone.Warning">
                                @clearNotice
                                <div><SecondaryButton OnClick="@(() => clearNotice = "")">Got it</SecondaryButton></div>
                            </Notice>
                        }

                        @if (notKnownGameIds.Count > 0)
                        {
                            <Notice Tone="NoticeTone.Warning">
                                @(notKnownGameIds.Count == 1 ? "This game is" : "These games are") keyed, but the team is not known because an earlier game it depends on is blank:
                                @GameNames(notKnownGameIds).
                            </Notice>
                        }

                        <DataTable Label="Picks">
                            <TableHeader Columns="@PhoneColumns" ColumnsWide="@WideColumns">
                                <TableHeaderCell Text="#" />
                                <TableHeaderCell Text="Game" />
                                <TableHeaderCell Text="First team" />
                                <TableHeaderCell Text="Second team" />
                            </TableHeader>
                            @for (int i = 0; i < orderedGames.Count; i++)
                            {
                                var index = i;
                                var game = orderedGames[i];
                                var slots = matchups[game.Id];
                                string? pick = entry.Picks != null && entry.Picks.TryGetValue(game.Id, out var p) ? p : null;
                                <TableRow Columns="@PhoneColumns" ColumnsWide="@WideColumns" State="@(i == nextIndex ? RowState.Selected : RowState.Normal)">
                                    <TableCell Kind="CellKind.Muted">@(i + 1)</TableCell>
                                    <TableCell>
                                        <div>@game.BowlName <span class="bm-note">· @game.PointValue @(game.PointValue == 1 ? "pt" : "pts")</span></div>
                                        @if (missing.Contains(game.Id))
                                        {
                                            <Badge Tone="BadgeTone.Alert">No pick</Badge>
                                        }
                                        else if (notKnownGameIds.Contains(game.Id))
                                        {
                                            <Badge Tone="BadgeTone.Alert">Team not known</Badge>
                                        }
                                        @if (!string.IsNullOrEmpty(pick) && !IsPick(slots.Away, pick) && !IsPick(slots.Home, pick))
                                        {
                                            <div class="bm-note">Saved pick: @pick</div>
                                        }
                                    </TableCell>
                                    <TableCell>
                                        <CompactPickButton Name="@slots.AwayLabel" Team="@TeamInfoOf(slots.AwayLabel, game)"
                                                           Seed="@SeedOf(slots.Away, game.TeamAway, game.TeamAwaySeed)"
                                                           Selected="@IsPick(slots.Away, pick)" Disabled="@(slots.Away == null)"
                                                           AriaLabel="@($"{game.BowlName}: {slots.AwayLabel}")"
                                                           OnClick="@(() => SetDigit(index, '1'))" />
                                    </TableCell>
                                    <TableCell>
                                        <CompactPickButton Name="@slots.HomeLabel" Team="@TeamInfoOf(slots.HomeLabel, game)"
                                                           Seed="@SeedOf(slots.Home, game.TeamHome, game.TeamHomeSeed)"
                                                           Selected="@IsPick(slots.Home, pick)" Disabled="@(slots.Home == null)"
                                                           AriaLabel="@($"{game.BowlName}: {slots.HomeLabel}")"
                                                           OnClick="@(() => SetDigit(index, '2'))" />
                                    </TableCell>
                                </TableRow>
                            }
                        </DataTable>

                        @if (showCheck && FastEntry.Missing(orderedGames, allGames, entry.Picks).Any())
                        {
                            var stillMissing = FastEntry.Missing(orderedGames, allGames, entry.Picks);
                            <Notice Tone="NoticeTone.Warning" Title="@($"{stillMissing.Count} {(stillMissing.Count == 1 ? "game has" : "games have")} no pick")">
                                @string.Join(", ", stillMissing.Select(g => g.BowlName)).
                                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
                                    <SecondaryButton OnClick="@(() => showCheck = false)">Go back and fix</SecondaryButton>
                                    <PrimaryButton OnClick="@(() => Save(next: lastSaveWasNext, force: true))" Disabled="@isSaving">Save anyway</PrimaryButton>
                                </MudStack>
                            </Notice>
                        }

                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd">
                            @if (string.IsNullOrEmpty(EntryId))
                            {
                                <SecondaryButton Disabled="@isSaving" OnClick="ResetForm">Clear</SecondaryButton>
                                <SecondaryButton Disabled="@isSaving" OnClick="@(() => Save(next: false, force: false))">Save and close</SecondaryButton>
                                <PrimaryButton Icon="@Icons.Material.Outlined.Save" Disabled="@isSaving"
                                               OnClick="@(() => Save(next: true, force: false))">@(isSaving ? "Saving..." : "Save and start next entry")</PrimaryButton>
                            }
                            else
                            {
                                <SecondaryButton Icon="@Icons.Material.Outlined.DeleteOutline" Disabled="@isSaving" OnClick="DeleteEntry">Delete</SecondaryButton>
                                <PrimaryButton Icon="@Icons.Material.Outlined.Save" Disabled="@isSaving"
                                               OnClick="@(() => Save(next: false, force: false))">@(isSaving ? "Saving..." : "Save changes")</PrimaryButton>
                            }
                        </MudStack>
                    </Card>
                }
            </MudItem>
        </MudGrid>
    }
</PageContainer>

@code {
    // Phone: the table scrolls inside its box if it must. Wide: number, game, then the two teams.
    private const string PhoneColumns = "28px minmax(96px, 1.2fr) minmax(96px, 1fr) minmax(96px, 1fr)";
    private const string WideColumns = "40px minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr)";

    [Parameter] public string? EntryId { get; set; }
    [SupplyParameterFromQuery] public string? SeasonId { get; set; }

    private List<BowlGame> allGames = new();
    private List<BowlPool> pools = new();
    private List<UserProfile> users = new();
    private BracketEntry entry = new BracketEntry();
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool paid = false;

    // Fast entry: the pool's games in printed-form order and the digits typed so far.
    private List<BowlGame> orderedGames = new();
    private string sequence = "";
    private List<string> notKnownGameIds = new();
    // The picks as saved when the entry was opened. The digits replace a saved pick only for a game that is keyed;
    // every other saved pick stays as it is (a knocked-out team, a game outside the pool), so a save never drops it.
    private Dictionary<string, string> savedPicks = new();
    private bool showCheck = false;
    private bool lastSaveWasNext = false;
    private string clearNotice = "";
    private MudTextField<string>? nameField;

    // Owner: an account (label "Name (email)") or a typed name.
    private string? ownerText;
    private Dictionary<string, UserProfile> ownerByLabel = new(StringComparer.OrdinalIgnoreCase);

    private string TieBreakerText
    {
        get
        {
            var pool = pools.FirstOrDefault(p => p.Id == entry.PoolId);
            var tieBreakerGame = allGames.FirstOrDefault(g => g.Id == pool?.TieBreakerGameId);
            return tieBreakerGame != null ? $"Tiebreaker: total points, {tieBreakerGame.BowlName}" : "Tiebreaker: total points";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            // Resolve Season Context
            string targetSeasonId = SeasonId ?? "";
            if (string.IsNullOrEmpty(targetSeasonId))
            {
                var currentSeason = await SeasonService.GetCurrentSeasonAsync();
                targetSeasonId = currentSeason?.Id ?? "";
            }

            // Append seasonId to calls
            var gamesTask = Http.GetFromJsonAsync<List<BowlGame>>($"api/GetGames?seasonId={targetSeasonId}");
            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>($"api/GetPools?seasonId={targetSeasonId}");
            var usersTask = Http.GetFromJsonAsync<List<UserProfile>>($"api/GetUsers"); // Users are global

            await Task.WhenAll(gamesTask, poolsTask, usersTask);

            allGames = await gamesTask ?? new();
            pools = await poolsTask ?? new();
            users = await usersTask ?? new();

            if (!string.IsNullOrEmpty(EntryId))
            {
                // CRITICAL FIX: Pass seasonId to GetEntry
                var existingEntry = await Http.GetFromJsonAsync<BracketEntry>($"api/GetEntry?id={EntryId}&seasonId={targetSeasonId}");
                if (existingEntry != null)
                {
                    entry = existingEntry;
                    if (entry.Picks == null) entry.Picks = new Dictionary<string, string>();
                }
                else
                {
                    errorMessage = "Entry not found.";
                }
            }
            else
            {
                // New Entry Setup
                entry.SeasonId = targetSeasonId; // Ensure new entry has season context

                // Set default pool if only one active exists
                var activePools = pools.Where(p => !p.IsArchived).ToList();
                if (activePools.Count == 1) entry.PoolId = activePools[0].Id;
            }

            RebuildOrder();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<BowlGame> PoolGames()
    {
        if (string.IsNullOrEmpty(entry.PoolId)) return new List<BowlGame>();

        var targetPool = pools.FirstOrDefault(p => p.Id == entry.PoolId);
        if (targetPool != null && targetPool.GameIds != null && targetPool.GameIds.Any())
        {
            return allGames.Where(g => targetPool.GameIds.Contains(g.Id)).ToList();
        }

        return allGames;
    }

    // Same order as the printed blank form (GameOrder in Core). The digits are rebuilt from the entry's picks.
    private void RebuildOrder()
    {
        orderedGames = GameOrder.ForEntry(PoolGames());
        paid = entry.IsPaid;
        ownerByLabel = users.GroupBy(OwnerLabel, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var account = string.IsNullOrEmpty(entry.UserId) ? null : users.FirstOrDefault(u => u.Id == entry.UserId);
        // An account that is no longer in the user list still owns the entry: say so rather than showing a blank owner.
        ownerText = account != null ? OwnerLabel(account)
            : !string.IsNullOrWhiteSpace(entry.OwnerName) ? entry.OwnerName
            : !string.IsNullOrEmpty(entry.UserId) ? $"Account not found ({entry.UserId})"
            : null;

        savedPicks = new Dictionary<string, string>(entry.Picks ?? new Dictionary<string, string>());
        sequence = FastEntry.SequenceFor(orderedGames, allGames, savedPicks);
        clearNotice = "";
        ApplySequence();
    }

    private void ApplySequence()
    {
        var result = FastEntry.Apply(orderedGames, allGames, sequence, savedPicks);
        sequence = result.Sequence;
        notKnownGameIds = result.NotKnownGameIds.ToList();
        entry.Picks = result.Picks;
    }

    private void OnSequenceChanged(string typed) => Rekey(typed);

    // Click a team to set or fix one game: its digit in the sequence changes.
    private void SetDigit(int index, char digit) => Rekey(FastEntry.WithDigit(sequence, index, digit));

    // A changed game clears the later playoff games that built on it, and says which (owner decision 2026-11-25).
    private void Rekey(string newSequence)
    {
        var rekey = FastEntry.ClearDependents(orderedGames, allGames, sequence, newSequence, savedPicks);
        foreach (var id in rekey.ClearedGameIds) savedPicks.Remove(id);
        if (rekey.ClearedGameIds.Count > 0)
            clearNotice = $"That change cleared the pick for {GameNames(rekey.ClearedGameIds)}. Key {(rekey.ClearedGameIds.Count == 1 ? "it" : "them")} again.";

        sequence = rekey.Sequence;
        ApplySequence();
        showCheck = false;
    }

    // --- Owner ---
    private static string OwnerLabel(UserProfile u) =>
        string.IsNullOrWhiteSpace(u.DisplayName) ? u.Email : $"{u.DisplayName} ({u.Email})";

    private Task<IEnumerable<string>> SearchOwners(string? text, CancellationToken token)
    {
        IEnumerable<UserProfile> found = string.IsNullOrWhiteSpace(text)
            ? users
            : users.Where(u => u.Email.Contains(text, StringComparison.OrdinalIgnoreCase)
                            || (u.DisplayName ?? "").Contains(text, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult<IEnumerable<string>>(found.OrderBy(u => u.Email).Take(25).Select(OwnerLabel).ToList());
    }

    // A chosen account sets the owner's account; any other text is the name of someone with no account.
    private void OnOwnerChanged(string? text)
    {
        if (string.Equals(text, ownerText, StringComparison.Ordinal)) return;
        ownerText = text;
        var typed = (text ?? "").Trim();
        if (typed.Length > 0 && ownerByLabel.TryGetValue(typed, out var account))
        {
            entry.UserId = account.Id;
            entry.OwnerName = null;
        }
        else
        {
            entry.UserId = "";
            entry.OwnerName = typed.Length > 0 ? typed : null;
        }
    }

    private async Task OnPoolChanged(string poolId)
    {
        if (entry.PoolId == poolId) return;

        // Another pool has different games, so keyed picks cannot carry over: ask before throwing them away.
        if (!string.IsNullOrEmpty(sequence) &&
            !await JS.InvokeAsync<bool>("confirm", "Changing the pool clears the picks keyed so far. Continue?"))
        {
            StateHasChanged();
            return;
        }

        entry.PoolId = poolId;
        entry.Picks = new Dictionary<string, string>();
        clearNotice = "";
        showCheck = false;
        RebuildOrder();
    }

    // --- Picks ---
    private int PickedCount() =>
        EntryPickRules.CountValid(allGames, orderedGames.Select(g => g.Id), entry.Picks);

    private string GameNames(IEnumerable<string> gameIds) =>
        string.Join(", ", gameIds.Select(id => allGames.FirstOrDefault(g => g.Id == id)?.BowlName ?? "a game"));

    private TeamInfo? TeamInfoOf(string label, BowlGame game) => VisualHelper.GetTeamInfo(label, game, allGames);

    // A seed belongs to the game's own team; a team that moved in from an earlier game has no seed here.
    private static int? SeedOf(string? slotTeam, string gameTeam, int? seed) =>
        slotTeam != null && string.Equals(slotTeam, gameTeam, StringComparison.OrdinalIgnoreCase) ? seed : null;

    private static bool IsPick(string? team, string? pick) =>
        team != null && !string.IsNullOrEmpty(pick) && string.Equals(team, pick, StringComparison.OrdinalIgnoreCase);

    // --- Move Entry (issue 132) ---
    private bool showMove = false;
    private string targetPoolId = "";
    private bool isMoving = false;
    private string moveError = "";
    private int targetMissingPicks = 0;

    // Same season as the entry, not archived, not the pool it is in now.
    private List<BowlPool> MoveTargets => pools
        .Where(p => p.Id != entry.PoolId && !p.IsArchived && p.SeasonId == entry.SeasonId)
        .OrderBy(p => p.Name)
        .ToList();

    private void OpenMove()
    {
        targetPoolId = "";
        targetMissingPicks = 0;
        moveError = "";
        showMove = true;
    }

    private void CloseMove()
    {
        if (isMoving) return;
        showMove = false;
    }

    private void OnTargetPoolChanged(string poolId)
    {
        targetPoolId = poolId ?? "";
        moveError = "";

        // Games in the target pool that this entry has no pick for.
        var target = pools.FirstOrDefault(p => p.Id == targetPoolId);
        if (target == null) { targetMissingPicks = 0; return; }
        var targetGameIds = target.GameIds != null && target.GameIds.Any() ? target.GameIds : allGames.Select(g => g.Id).ToList();
        targetMissingPicks = targetGameIds.Count(id => entry.Picks == null || !entry.Picks.TryGetValue(id, out var pick) || string.IsNullOrWhiteSpace(pick));
    }

    private async Task ExecuteMove()
    {
        if (string.IsNullOrEmpty(targetPoolId) || isMoving) return;

        isMoving = true;
        moveError = "";
        try
        {
            var response = await Http.PostAsync($"api/MoveEntry?entryId={Uri.EscapeDataString(entry.Id)}&seasonId={Uri.EscapeDataString(entry.SeasonId)}&newPoolId={Uri.EscapeDataString(targetPoolId)}", null);
            if (response.IsSuccessStatusCode)
            {
                showMove = false;
                // Load the entry again so unsaved picks for the old pool are never posted into the new one.
                await LoadData();
                clearNotice = "";
                Snackbar.Add("Entry moved.", Severity.Success);
            }
            else
            {
                moveError = $"Move failed: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            moveError = $"Error: {ex.Message}";
        }
        finally
        {
            isMoving = false;
        }
    }

    // --- Save ---
    /// <param name="next">New entry: clear the form (keeping the pool) so the next paper entry can be keyed.</param>
    /// <param name="force">Save even though some games have no pick (after the check was shown).</param>
    private async Task Save(bool next, bool force)
    {
        errorMessage = null;
        lastSaveWasNext = next;

        if (string.IsNullOrWhiteSpace(entry.PlayerName))
        {
            errorMessage = "Type an entry name.";
            return;
        }
        if (string.IsNullOrEmpty(entry.PoolId))
        {
            errorMessage = "Please select a pool.";
            return;
        }
        if (string.IsNullOrEmpty(entry.UserId) && string.IsNullOrWhiteSpace(entry.OwnerName))
        {
            errorMessage = "Say who this entry belongs to: choose their account, or type their name.";
            return;
        }

        // The check before save, for new paper entries: list the games with no pick, then fix them or save anyway.
        // Editing an entry that is saved part-way saves straight away (BUSINESS-RULES section 3).
        if (!force && string.IsNullOrEmpty(EntryId) && FastEntry.Missing(orderedGames, allGames, entry.Picks).Any())
        {
            showCheck = true;
            return;
        }

        isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/CreateEntry", entry);
            if (!response.IsSuccessStatusCode)
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to save entry: {errorText}";
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<BracketEntry>();
            var savedName = entry.PlayerName;
            showCheck = false;

            // Payment has its own endpoint (a save never changes it): set it when the box differs from what is stored.
            if (saved != null && saved.IsPaid != paid)
            {
                var payResponse = await Http.PostAsync($"api/SetEntryPaidStatus?id={Uri.EscapeDataString(saved.Id)}&isPaid={paid}&seasonId={Uri.EscapeDataString(saved.SeasonId)}", null);
                if (payResponse.IsSuccessStatusCode)
                {
                    saved.IsPaid = paid;
                }
                else
                {
                    Snackbar.Add($"Saved {savedName}, but the payment could not be set. Set it on the Payments page.", Severity.Warning);
                }
            }

            Snackbar.Add($"Saved {savedName}.", Severity.Success);

            if (string.IsNullOrEmpty(EntryId))
            {
                if (next)
                {
                    ResetForm();
                    StateHasChanged();
                    if (nameField != null) await nameField.FocusAsync();
                }
                else
                {
                    Nav.NavigateTo("/admin/entries");
                }
            }
            else if (saved != null)
            {
                entry = saved;
                if (entry.Picks == null) entry.Picks = new Dictionary<string, string>();
                RebuildOrder();
            }
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task DeleteEntry()
    {
        if (string.IsNullOrEmpty(EntryId)) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the entry for {entry.PlayerName}?");
        if (confirmed)
        {
            isSaving = true;
            try
            {
                // Use entry.SeasonId if available, otherwise fallback to current context
                string sid = !string.IsNullOrEmpty(entry.SeasonId) ? entry.SeasonId : (SeasonId ?? "");
                var response = await Http.DeleteAsync($"api/DeleteEntry/{EntryId}?seasonId={sid}");
                if (response.IsSuccessStatusCode) { Nav.NavigateTo("/admin/entries"); } else { errorMessage = "Error deleting entry."; }
            }
            catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
            finally { isSaving = false; }
        }
    }

    private void ResetForm()
    {
        var seasonId = entry.SeasonId;
        var poolId = entry.PoolId;

        entry = new BracketEntry { SeasonId = seasonId, PoolId = poolId };
        clearNotice = "";
        showCheck = false;
        errorMessage = null;

        // Re-apply default if only one active exists
        if (string.IsNullOrEmpty(entry.PoolId))
        {
            var activePools = pools.Where(p => !p.IsArchived).ToList();
            if (activePools.Count == 1) entry.PoolId = activePools[0].Id;
        }
        RebuildOrder();
    }
}
