@page "/admin/entry"
@page "/admin/entry/{EntryId}"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core
@using BowlPoolManager.Core.Helpers
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Text.Json

@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS 
@inject BowlPoolManager.Client.Services.ISeasonService SeasonService 

<PageTitle>@(string.IsNullOrEmpty(EntryId) ? "New" : "Edit") Bracket Entry</PageTitle>

<div class="container-fluid mt-3 px-4 position-relative pb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-center gap-3">
                <h1 class="h3 fw-bold mb-0"><i class="bi bi-pencil-square text-primary"></i> @(string.IsNullOrEmpty(EntryId) ? "New" : "Edit") Bracket Entry</h1>
            </div>
        </div>
        <a href="/admin/entries" class="btn btn-outline-secondary">Back to List</a>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else
    {
        <EditForm Model="@entry" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(statusMessage) && string.IsNullOrEmpty(EntryId))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @statusMessage
                    <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @* PLAYER, POOL & OWNER INFO *@
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">Entry Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        @* 1. Player Name *@
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Bracket Name</label>
                            <InputText class="form-control" @bind-Value="entry.PlayerName" placeholder="e.g. John's Picks" />
                            <ValidationMessage For="@(() => entry.PlayerName)" />
                        </div>

                        @* 2. Pool Selection *@
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Pool</label>
                            @if (string.IsNullOrEmpty(EntryId))
                            {
                                <InputSelect class="form-select" @bind-Value="entry.PoolId">
                                    <option value="">-- Select Pool --</option>
                                    @foreach (var p in pools.Where(p => !p.IsArchived))
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </InputSelect>
                            }
                            else
                            {
                                <div class="input-group">
                                    <input type="text" class="form-control" value="@(pools.FirstOrDefault(p => p.Id == entry.PoolId)?.Name ?? "Unknown")" disabled />
                                    <button class="btn btn-outline-warning" type="button" @onclick="OpenMoveModal">
                                        <i class="bi bi-arrow-left-right"></i> Move
                                    </button>
                                </div>
                            }
                        </div>

                        @* 3. Owner Selection (NEW) *@
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Owner (User)</label>
                            <InputSelect class="form-select" @bind-Value="entry.UserId">
                                <option value="">-- Unassigned --</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.Email</option>
                                }
                            </InputSelect>
                            <div class="form-text small">Who manages this bracket?</div>
                        </div>
                    </div>
                </div>
            </div>

            @* GAME SELECTION (MYPICKS STYLE) *@
            @if (!string.IsNullOrEmpty(entry.PoolId))
            {
                <div class="card shadow-sm mb-5">
                    @{ var poolGames = ValidGames; var picked = PickedCount(poolGames); }
                    <div class="card-header bg-dark text-white fw-bold">
                        Picks: @picked of @poolGames.Count picked@(poolGames.Count - picked > 0 ? $", {poolGames.Count - picked} left" : "")
                    </div>
                    @if (!string.IsNullOrEmpty(clearNotice))
                    {
                        <div class="alert alert-warning alert-dismissible m-3 mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @clearNotice
                            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => clearNotice = string.Empty"></button>
                        </div>
                    }
                    <ul class="list-group list-group-flush">
                        @{ var matchups = EntryPickRules.Resolve(allGames, entry.Picks); }
                        @foreach (var game in poolGames.OrderBy(g => g.IsPlayoff).ThenBy(g => g.StartTime))
                        {
                            string pick = "";
                            if (entry.Picks?.TryGetValue(game.Id, out var p) == true)
                            {
                                pick = p;
                            }

                            bool isSelected = !string.IsNullOrEmpty(pick);
                            var slots = matchups[game.Id];
                            var waiting = new[] { slots.HomeWaitsFor, slots.AwayWaitsFor }.Where(n => n != null).ToList();

                            <li class="list-group-item p-3 @(isSelected ? "bg-light-success" : "")">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-secondary">@game.BowlName</span>
                                        @if (game.IsPlayoff)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Playoff</span>
                                        }
                                        @if (clearedGameIds.Contains(game.Id))
                                        {
                                            <span class="badge bg-info text-dark ms-1">Pick cleared</span>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <div class="small fw-bold text-dark">
                                            @DateTimeHelper.ToCentralLabel(game.StartTime, "MMM d, h:mm tt")
                                        </div>
                                        <div class="small text-muted" style="font-size: 0.85em;">
                                            @game.Location 
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row g-2">
                                    <div class="col">
                                        <input type="radio" class="btn-check" name="@game.Id" id="@($"{game.Id}_home")"
                                               checked="@(slots.Home != null && pick == slots.Home)"
                                               disabled="@(slots.Home == null)"
                                               @onchange="@(() => UpdatePick(game.Id, slots.Home ?? ""))" autocomplete="off">

                                        <label class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center h-100 @(slots.Home != null && pick == slots.Home ? "active fw-bold" : "") @(slots.Home == null ? "disabled opacity-50" : "")"
                                               for="@($"{game.Id}_home")">
                                            @slots.HomeLabel
                                        </label>
                                    </div>

                                    <div class="col">
                                        <input type="radio" class="btn-check" name="@game.Id" id="@($"{game.Id}_away")"
                                               checked="@(slots.Away != null && pick == slots.Away)"
                                               disabled="@(slots.Away == null)"
                                               @onchange="@(() => UpdatePick(game.Id, slots.Away ?? ""))" autocomplete="off">

                                        <label class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center h-100 @(slots.Away != null && pick == slots.Away ? "active fw-bold" : "") @(slots.Away == null ? "disabled opacity-50" : "")"
                                               for="@($"{game.Id}_away")">
                                            @slots.AwayLabel
                                        </label>
                                    </div>
                                </div>
                                @if (waiting.Any())
                                {
                                    <div class="small text-muted fst-italic mt-2"><i class="bi bi-info-circle me-1"></i>Pick @string.Join(" and ", waiting) first.</div>
                                }
                            </li>
                        }
                    </ul>
                </div>

                @* TIEBREAKER *@
                <div class="card mb-4 shadow-sm border-warning">
                    <div class="card-body bg-warning bg-opacity-10">
                        @{
                            var pool = pools.FirstOrDefault(p => p.Id == entry.PoolId);
                            var tieBreakerGame = allGames.FirstOrDefault(g => g.Id == pool?.TieBreakerGameId);
                            string tbText = tieBreakerGame != null 
                                ? $"Tiebreaker: Total Points in {tieBreakerGame.BowlName} - {tieBreakerGame.TeamHome} vs {tieBreakerGame.TeamAway}"
                                : "Tiebreaker: Total Points";
                        }
                        <label class="form-label fw-bold text-dark">@tbText</label>
                        <InputNumber @bind-Value="entry.TieBreakerPoints" class="form-control" />
                    </div>
                </div>
            }

            <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-5">
                <button type="button" class="btn btn-secondary me-2" @onclick="ResetForm" disabled="@isSaving">Clear / Reset</button>
                @if (!string.IsNullOrEmpty(EntryId))
                {
                    <button type="button" class="btn btn-danger me-2" @onclick="DeleteEntry" disabled="@isSaving"><i class="bi bi-trash"></i> Delete</button>
                }
                <button type="submit" class="btn btn-success btn-lg px-5" disabled="@isSaving">
                    @if (isSaving) { <span class="spinner-border spinner-border-sm me-2"></span><span>Saving...</span> }
                    else { <i class="bi bi-save"></i> <span>Save Entry</span> }
                </button>
            </div>
            
            @* AUDIT LOG *@
            <div class="card mb-4 shadow-sm mt-4">
                <div class="card-header bg-secondary text-white small py-1">
                    <i class="bi bi-clock-history me-1"></i> Audit Log
                </div>
                <div class="card-body bg-light p-2" style="max-height: 250px; overflow-y: auto; font-family: monospace; font-size: 0.85em;">
                    @if (entry.AuditLog != null && entry.AuditLog.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var log in entry.AuditLog.AsEnumerable().Reverse())
                            {
                                <li class="mb-1 border-bottom pb-1">@log</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted fst-italic p-2">No audit history.</div>
                    }
                </div>
            </div>
        </EditForm>
        
        @* MOVE MODAL *@
        @if (showMoveModal)
        {
            <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Move Entry to Pool</h5>
                            <button type="button" class="btn-close" @onclick="CloseMoveModal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Select the new pool for <strong>@entry.PlayerName</strong> (pools of the same season only):</p>
                            @if (!MoveTargets.Any())
                            {
                                <div class="alert alert-secondary mb-0">There is no other open pool in this season to move the entry to.</div>
                            }
                            else
                            {
                                <select class="form-select" value="@targetPoolId" @onchange="OnTargetPoolChanged">
                                    <option value="">-- Select Target Pool --</option>
                                    @foreach (var p in MoveTargets)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            }

                            @if (!string.IsNullOrEmpty(targetPoolId) && targetMissingPicks > 0)
                            {
                                <div class="alert alert-warning mt-3 mb-0">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    @(targetMissingPicks == 1 ? "1 game in that pool has" : $"{targetMissingPicks} games in that pool have") no pick from this entry.
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(moveError))
                            {
                                <div class="alert alert-danger mt-3 mb-0">@moveError</div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseMoveModal" disabled="@isMoving">Cancel</button>
                            <button type="button" class="btn btn-warning" @onclick="ExecuteMove" disabled="@(isMoving || string.IsNullOrEmpty(targetPoolId))">
                                @if (isMoving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Confirm Move
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (showToast)
        {
            <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1050">
                <div class="toast show align-items-center text-white bg-success border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body fs-6"><i class="bi bi-check-circle-fill me-2"></i> @toastMessage</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => showToast = false"></button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string? EntryId { get; set; }
    [SupplyParameterFromQuery] public string? SeasonId { get; set; }

    private List<BowlGame> allGames = new();
    private List<BowlPool> pools = new();
    private List<UserProfile> users = new();
    private BracketEntry entry = new BracketEntry();
    private string? statusMessage;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showToast = false;
    private string toastMessage = "";
    
    // Move Modal
    private bool showMoveModal = false;
    private string targetPoolId = "";

    private List<BowlGame> ValidGames 
    {
        get 
        {
            if (string.IsNullOrEmpty(entry.PoolId)) return new List<BowlGame>();
            
            var targetPool = pools.FirstOrDefault(p => p.Id == entry.PoolId);
            if (targetPool != null && targetPool.GameIds != null && targetPool.GameIds.Any())
            {
                return allGames.Where(g => targetPool.GameIds.Contains(g.Id)).ToList();
            }
            
            return allGames;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            // Resolve Season Context
            string targetSeasonId = SeasonId ?? "";
            if (string.IsNullOrEmpty(targetSeasonId))
            {
                var currentSeason = await SeasonService.GetCurrentSeasonAsync();
                targetSeasonId = currentSeason?.Id ?? "";
            }

            // Append seasonId to calls
            var gamesTask = Http.GetFromJsonAsync<List<BowlGame>>($"api/GetGames?seasonId={targetSeasonId}");
            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>($"api/GetPools?seasonId={targetSeasonId}");
            var usersTask = Http.GetFromJsonAsync<List<UserProfile>>($"api/GetUsers"); // Users are global
            
            await Task.WhenAll(gamesTask, poolsTask, usersTask);
            
            allGames = await gamesTask ?? new();
            pools = await poolsTask ?? new();
            users = await usersTask ?? new();

            if (!string.IsNullOrEmpty(EntryId))
            {
                // CRITICAL FIX: Pass seasonId to GetEntry
                var existingEntry = await Http.GetFromJsonAsync<BracketEntry>($"api/GetEntry?id={EntryId}&seasonId={targetSeasonId}");
                if (existingEntry != null)
                {
                    entry = existingEntry;
                    if (entry.Picks == null) entry.Picks = new Dictionary<string, string>();
                }
                else
                {
                    errorMessage = "Entry not found.";
                }
            }
            else
            {
                // New Entry Setup
                entry.SeasonId = targetSeasonId; // Ensure new entry has season context

                // Set default pool if only one active exists
                var activePools = pools.Where(p => !p.IsArchived).ToList();
                if (activePools.Count == 1) entry.PoolId = activePools[0].Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Cleared-pick notice (issue 128)
    private string clearNotice = "";
    private HashSet<string> clearedGameIds = new();

    private int PickedCount(List<BowlGame> poolGames) =>
        EntryPickRules.CountValid(allGames, poolGames.Select(g => g.Id), entry.Picks);

    private string GameNames(IEnumerable<string> gameIds) =>
        string.Join(", ", gameIds.Select(id => allGames.FirstOrDefault(g => g.Id == id)?.BowlName ?? "a game"));

    private void UpdatePick(string gameId, string selection)
    {
        if (entry.Picks == null) entry.Picks = new Dictionary<string, string>();
        if (string.IsNullOrEmpty(selection))
        {
            if (entry.Picks.ContainsKey(gameId)) entry.Picks.Remove(gameId);
        }
        else
        {
            entry.Picks[gameId] = selection;
        }

        // A changed pick can break later picks that built on it: clear them and say which.
        var cleaned = EntryPickRules.ClearInvalid(allGames, entry.Picks);
        entry.Picks = cleaned.Picks;
        clearedGameIds.Remove(gameId);
        if (cleaned.ClearedGameIds.Count > 0)
        {
            var gameName = allGames.FirstOrDefault(g => g.Id == gameId)?.BowlName ?? "that game";
            clearedGameIds = new HashSet<string>(cleaned.ClearedGameIds);
            clearNotice = $"Changing the pick for {gameName} cleared the pick for {GameNames(cleaned.ClearedGameIds)}. Pick again.";
        }
        else if (clearedGameIds.Count == 0)
        {
            clearNotice = "";
        }
        StateHasChanged();
    }

    // --- Move Entry (issue 132) ---
    private bool isMoving = false;
    private string moveError = "";
    private int targetMissingPicks = 0;

    // Same season as the entry, not archived, not the pool it is in now.
    private List<BowlPool> MoveTargets => pools
        .Where(p => p.Id != entry.PoolId && !p.IsArchived && p.SeasonId == entry.SeasonId)
        .OrderBy(p => p.Name)
        .ToList();

    private void OpenMoveModal()
    {
        targetPoolId = "";
        targetMissingPicks = 0;
        moveError = "";
        showMoveModal = true;
    }

    private void CloseMoveModal()
    {
        if (isMoving) return;
        showMoveModal = false;
    }

    private void OnTargetPoolChanged(ChangeEventArgs e)
    {
        targetPoolId = e.Value?.ToString() ?? "";
        moveError = "";

        // Games in the target pool that this entry has no pick for.
        var target = pools.FirstOrDefault(p => p.Id == targetPoolId);
        if (target == null) { targetMissingPicks = 0; return; }
        var targetGameIds = target.GameIds != null && target.GameIds.Any() ? target.GameIds : allGames.Select(g => g.Id).ToList();
        targetMissingPicks = targetGameIds.Count(id => entry.Picks == null || !entry.Picks.TryGetValue(id, out var pick) || string.IsNullOrWhiteSpace(pick));
    }

    private async Task ExecuteMove()
    {
        if (string.IsNullOrEmpty(targetPoolId) || isMoving) return;

        isMoving = true;
        moveError = "";
        try 
        {
            var response = await Http.PostAsync($"api/MoveEntry?entryId={Uri.EscapeDataString(entry.Id)}&seasonId={Uri.EscapeDataString(entry.SeasonId)}&newPoolId={Uri.EscapeDataString(targetPoolId)}", null);
            if (response.IsSuccessStatusCode)
            {
                showMoveModal = false;
                // Load the entry again so unsaved picks for the old pool are never posted into the new one.
                await LoadData();
                clearNotice = "";
                clearedGameIds = new HashSet<string>();
                toastMessage = "Entry moved successfully.";
                showToast = true;
            }
            else 
            {
                moveError = $"Move failed: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            moveError = $"Error: {ex.Message}";
        }
        finally
        {
            isMoving = false;
        }
    }
    private async Task HandleSave()
    {
        if (string.IsNullOrEmpty(entry.PoolId))
        {
            errorMessage = "Please select a pool.";
            return;
        }
        
        statusMessage = null; errorMessage = null; showToast = false; isSaving = true;
        try
        {
            // Use CreateEntry instead of SaveEntry
            var response = await Http.PostAsJsonAsync("api/CreateEntry", entry);
            if (response.IsSuccessStatusCode)
            {
                toastMessage = "Changes saved successfully!";
                showToast = true;
                if (string.IsNullOrEmpty(EntryId)) { statusMessage = $"Entry for {entry.PlayerName} saved!"; ResetForm(); }
                _ = Task.Delay(3000).ContinueWith(t => { showToast = false; InvokeAsync(StateHasChanged); });
            }
            else 
            { 
                 var errorText = await response.Content.ReadAsStringAsync();
                 errorMessage = $"Failed to save entry: {errorText}"; 
            }
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task DeleteEntry()
    {
        if (string.IsNullOrEmpty(EntryId)) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the entry for {entry.PlayerName}?");
        if (confirmed) {
            isSaving = true;
            try {
                // Use entry.SeasonId if available, otherwise fallback to current context
                string sid = !string.IsNullOrEmpty(entry.SeasonId) ? entry.SeasonId : (SeasonId ?? "");
                var response = await Http.DeleteAsync($"api/DeleteEntry/{EntryId}?seasonId={sid}");
                if (response.IsSuccessStatusCode) { Nav.NavigateTo("/admin/entries"); } else { errorMessage = "Error deleting entry."; }
            } catch(Exception ex) { errorMessage = $"Error: {ex.Message}"; } finally { isSaving = false; }
        }
    }

    private void ResetForm()
    {
        entry = new BracketEntry();
        // Re-apply default if only one active exists
        var activePools = pools.Where(p => !p.IsArchived).ToList();
        if (activePools.Count == 1) entry.PoolId = activePools[0].Id;
        
        if (!string.IsNullOrEmpty(EntryId)) { Nav.NavigateTo("/admin/entries"); }
    }
}
