@page "/admin/test-data"
@using System.Text.Json
@using BowlPoolManager.Core
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Constants.Roles.SuperAdmin)]
@inject HttpClient Http

<PageTitle>Test Data</PageTitle>

<div class="container-fluid mt-3 px-4">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h1 class="h3 fw-bold mb-0"><i class="bi bi-database-gear text-warning"></i> Test Data</h1>
        <a href="admin/dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>

    @if (loading)
    {
        <div class="text-muted">Checking environment...</div>
    }
    else if (!isTestEnvironment)
    {
        <div class="alert alert-secondary">Test data tools are only available on the test site.</div>
    }
    else
    {
        <div class="alert alert-warning border-warning border-2">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>This deletes all seasons, pools, games, entries and archives on the test site</strong>
            and loads the scenario you pick. Users are kept, so you stay SuperAdmin.
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold">Load a scenario</div>
            <div class="card-body">
                @foreach (var name in scenarios)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="scenario" id="sc-@name"
                               checked="@(selected == name)" @onchange="() => selected = name" />
                        <label class="form-check-label" for="sc-@name">
                            <strong>@name</strong>
                            <span class="text-muted small ms-2">@Describe(name)</span>
                        </label>
                    </div>
                }

                <div class="form-check mt-3 mb-3">
                    <input class="form-check-input" type="checkbox" id="confirm" @bind="confirmed" />
                    <label class="form-check-label" for="confirm">I understand the existing test data will be deleted.</label>
                </div>

                <button class="btn btn-danger" @onclick="Reset" disabled="@(busy || string.IsNullOrEmpty(selected) || !confirmed)">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Loading...</span>
                    }
                    else
                    {
                        <span>Reset and load</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="mt-3 p-2 rounded @(success ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                        <strong>@message</strong>
                    </div>
                }

                @if (deleted != null && loaded != null)
                {
                    <table class="table table-sm w-auto mt-3">
                        <thead><tr><th>Container</th><th class="text-end">Deleted</th><th class="text-end">Loaded</th></tr></thead>
                        <tbody>
                            @foreach (var container in deleted.Keys.Union(loaded.Keys))
                            {
                                <tr>
                                    <td>@container</td>
                                    <td class="text-end">@(deleted.GetValueOrDefault(container))</td>
                                    <td class="text-end">@(loaded.GetValueOrDefault(container))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool loading = true;
    private bool isTestEnvironment;
    private List<string> scenarios = new();
    private string? selected;
    private bool confirmed;
    private bool busy;
    private bool success;
    private string? message;
    private Dictionary<string, int>? deleted;
    private Dictionary<string, int>? loaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/TestEnvironment");
            if (response.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                isTestEnvironment = doc.RootElement.GetProperty("isTestEnvironment").GetBoolean();
                scenarios = doc.RootElement.GetProperty("scenarios").EnumerateArray().Select(e => e.GetString()!).ToList();
            }
        }
        catch (Exception)
        {
            isTestEnvironment = false;
        }
        loading = false;
    }

    private static string Describe(string name) => name switch
    {
        "before-selection-day" => "Current season and team lists, no pools.",
        "entry-window" => "Family and Office pools, all games scheduled, about 30 entries (some incomplete).",
        "mid-season" => "Same, locked, with about half the games final and one in progress.",
        _ => string.Empty
    };

    private async Task Reset()
    {
        busy = true;
        message = null;
        deleted = loaded = null;
        try
        {
            var response = await Http.PostAsync($"api/ResetTestData/{selected}", null);
            if (response.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                deleted = JsonSerializer.Deserialize<Dictionary<string, int>>(doc.RootElement.GetProperty("deleted").GetRawText());
                loaded = JsonSerializer.Deserialize<Dictionary<string, int>>(doc.RootElement.GetProperty("loaded").GetRawText());
                success = true;
                message = $"Loaded {selected}.";
                confirmed = false;
            }
            else
            {
                success = false;
                message = $"Error: {(int)response.StatusCode} {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            success = false;
            message = $"Exception: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
