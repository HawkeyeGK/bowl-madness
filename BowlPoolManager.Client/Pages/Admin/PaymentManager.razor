@page "/admin/payments"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core
@using Microsoft.AspNetCore.Authorization
@using BowlPoolManager.Client.Services
@using MudBlazor
@using System.Net.Http.Json
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISeasonService SeasonService
@inject ISnackbar Snackbar

@* Release 2 group C: payments. Same calls as before (SetEntryPaidStatus checks the caller on the server). *@

<PageContainer>
    <PageHeader Title="Payments" Subtitle="@Summary">
        <Actions>
            <SecondaryButton Href="/admin/dashboard" Icon="@Icons.Material.Outlined.ArrowBack">Dashboard</SecondaryButton>
        </Actions>
    </PageHeader>

    <Card Tone="CardTone.Outlined">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="SelectedPoolId" Label="Pool" Variant="Variant.Outlined" Disabled="@(Pools.Count == 0)">
                    <MudSelectItem T="string" Value="@("")">All pools (current season)</MudSelectItem>
                    @foreach (var pool in Pools)
                    {
                        <MudSelectItem T="string" Value="@pool.Id">@pool.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSwitch T="bool" @bind-Value="ShowUnpaidOnly" Label="Show unpaid only" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </Card>

    @if (IsLoading)
    {
        <LoadingIndicator Text="Loading entries..." />
    }
    else if (FilteredEntries.Count == 0)
    {
        <EmptyState Title="No entries found" Icon="@Icons.Material.Outlined.Payments">
            <ChildContent>No entries match these filters.</ChildContent>
        </EmptyState>
    }
    else
    {
        <DataTable Label="Entry payments">
            <TableHeader Columns="@PhoneColumns" ColumnsWide="@WideColumns">
                <TableHeaderCell Text="Bracket" OnSort="@(() => Sort("PlayerName"))" SortActive="@(CurrentSortColumn == "PlayerName")" Ascending="IsAscending" />
                <TableHeaderCell Text="Owner" HidePhone="true" OnSort="@(() => Sort("Email"))" SortActive="@(CurrentSortColumn == "Email")" Ascending="IsAscending" />
                <TableHeaderCell Text="Pool" HidePhone="true" OnSort="@(() => Sort("Pool"))" SortActive="@(CurrentSortColumn == "Pool")" Ascending="IsAscending" />
                <TableHeaderCell Text="Paid" End="true" OnSort="@(() => Sort("Status"))" SortActive="@(CurrentSortColumn == "Status")" Ascending="IsAscending" />
            </TableHeader>
            @foreach (var entry in FilteredEntries)
            {
                <TableRow Columns="@PhoneColumns" ColumnsWide="@WideColumns">
                    <TableCell Kind="CellKind.Name">
                        <span>@entry.PlayerName</span>
                        <span class="bm-only-phone"><Badge>@GetPoolName(entry.PoolId)</Badge></span>
                    </TableCell>
                    <TableCell HidePhone="true">@GetUserEmail(entry)</TableCell>
                    <TableCell HidePhone="true">@GetPoolName(entry.PoolId)</TableCell>
                    <TableCell End="true">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                            <Badge Tone="@(entry.IsPaid ? BadgeTone.Good : BadgeTone.Alert)">@(entry.IsPaid ? "Paid" : "Unpaid")</Badge>
                            <MudSwitch T="bool" Value="entry.IsPaid" ValueChanged="@(paid => TogglePayment(entry, paid))" Color="Color.Primary"
                                       AriaLabel="@($"{entry.PlayerName} paid")" />
                        </MudStack>
                    </TableCell>
                </TableRow>
            }
        </DataTable>
    }
</PageContainer>

@code {
    // Phone: name (with the pool) and the paid switch. Wide screens add email and pool.
    private const string PhoneColumns = "minmax(0, 1fr) 128px";
    private const string WideColumns = "minmax(160px, 1.4fr) minmax(180px, 1.6fr) minmax(120px, 1fr) 140px";

    private string Summary
    {
        get
        {
            var scope = AllEntries.Where(e => string.IsNullOrEmpty(SelectedPoolId) || e.PoolId == SelectedPoolId).ToList();
            int paid = scope.Count(e => e.IsPaid);
            return $"{scope.Count} {(scope.Count == 1 ? "entry" : "entries")}: {paid} paid, {scope.Count - paid} unpaid";
        }
    }

    private bool IsLoading = true;
    private string SelectedPoolId = "";
    private bool ShowUnpaidOnly = false;
    private string CurrentSortColumn = "PlayerName";
    private bool IsAscending = true;

    private List<BowlPool> Pools = new();
    private List<BracketEntry> AllEntries = new();
    private Dictionary<string, string> UserEmailMap = new();

    private List<BracketEntry> FilteredEntries
    {
        get
        {
            var query = AllEntries
                .Where(e => (string.IsNullOrEmpty(SelectedPoolId) || e.PoolId == SelectedPoolId) &&
                            (!ShowUnpaidOnly || !e.IsPaid));

            switch (CurrentSortColumn)
            {
                case "PlayerName":
                    query = IsAscending ? query.OrderBy(e => e.PlayerName) : query.OrderByDescending(e => e.PlayerName);
                    break;
                case "Email":
                    query = IsAscending 
                        ? query.OrderBy(e => GetUserEmail(e)) 
                        : query.OrderByDescending(e => GetUserEmail(e));
                    break;
                case "Pool":
                    query = IsAscending 
                        ? query.OrderBy(e => GetPoolName(e.PoolId)) 
                        : query.OrderByDescending(e => GetPoolName(e.PoolId));
                    break;
                case "Status":
                    query = IsAscending ? query.OrderBy(e => e.IsPaid) : query.OrderByDescending(e => e.IsPaid);
                    break;
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            // 0. Get Current Season
            var currentSeason = await SeasonService.GetCurrentSeasonAsync();
            var currentSeasonId = currentSeason?.Id;

            if (string.IsNullOrEmpty(currentSeasonId))
            {
                // Safety valve if no season is found? 
                Console.WriteLine("No current season found.");
                IsLoading = false;
                return;
            }

            // 1. Load Pools for Current Season ONLY
            var allPools = await Http.GetFromJsonAsync<List<BowlPool>>($"api/GetPools?seasonId={currentSeasonId}") ?? new();
            // FILTER: Strictly by Season
            Pools = allPools.Where(p => p.SeasonId == currentSeasonId || p.Season.ToString() == currentSeasonId).ToList();

            // 2. Load Users for Email Lookup
            var users = await Http.GetFromJsonAsync<List<UserProfile>>("api/GetUsers") ?? new();
            UserEmailMap = users.ToDictionary(u => u.Id, u => u.Email);

            // 3. Load Entries
            AllEntries.Clear();
            foreach (var pool in Pools)
            {
                var poolEntries = await Http.GetFromJsonAsync<List<BracketEntry>>($"api/GetEntries?poolId={pool.Id}");
                if (poolEntries != null)
                {
                    AllEntries.AddRange(poolEntries);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetPoolName(string poolId)
    {
        var pool = Pools.FirstOrDefault(p => p.Id == poolId);
        return pool?.Name ?? "Unknown Pool";
    }

    // The owner's email; for someone with no account, the name an Admin typed.
    private string GetUserEmail(BracketEntry entry)
    {
        if (UserEmailMap.TryGetValue(entry.UserId, out var email)) return email;
        return string.IsNullOrWhiteSpace(entry.OwnerName) ? "Admin Entered" : $"{entry.OwnerName} (no account)";
    }

    private void Sort(string column)
    {
        if (CurrentSortColumn == column)
        {
            IsAscending = !IsAscending;
        }
        else
        {
            CurrentSortColumn = column;
            IsAscending = true;
        }
    }

    private async Task TogglePayment(BracketEntry entry, bool isPaid)
    {
        try
        {
            // Optimistic Update
            entry.IsPaid = isPaid;

            // Call API
            var response = await Http.PostAsync($"api/SetEntryPaidStatus?id={entry.Id}&isPaid={isPaid}&seasonId={entry.SeasonId}", null);
            if (!response.IsSuccessStatusCode)
            {
                // Revert on failure
                entry.IsPaid = !isPaid;
                Snackbar.Add($"Could not update payment for {entry.PlayerName}.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
             entry.IsPaid = !isPaid;
             Snackbar.Add($"Could not update payment for {entry.PlayerName}: {ex.Message}", Severity.Error);
        }
    }
}
