@page "/what-if"
@implements IDisposable
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core
@using BowlPoolManager.Core.Helpers
@using BowlPoolManager.Client.Services

@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject ISeasonService SeasonService
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject PoolSelection PoolSelection
@inject MyEntryStore MyEntryStore

@using BowlPoolManager.Client.Components
@using BowlPoolManager.Client.Helpers

<style>
    /* 1. SCROLL CONTAINER */
    .matrix-container {
        display: block;
        width: 100%;
        max-width: 100%;
        height: calc(100vh - 240px); /* the page header and the view tabs sit above it */
        overflow: auto; 
        border: 1px solid #dee2e6;
        background-color: white;
        position: relative;
        -webkit-overflow-scrolling: touch;
    }

    /* 2. TABLE BASE */
    .matrix-table {
        border-collapse: separate; 
        border-spacing: 0;
        table-layout: fixed; /* Force fixed layout */
        width: 100%; /* Fill the page; the game columns share the extra space */
        margin-bottom: 0;
    }
    /* Never narrower than the natural size (name column + 70px per game): a narrow screen scrolls sideways.
       Screen only; printing sizes the table itself. */
    @@media screen {
        .matrix-table { min-width: var(--matrix-min-width, 0); }
    }

    /* 3. COLUMNS */
    .matrix-table th, 
    .matrix-table td {
        vertical-align: middle;
        text-align: center;
        width: auto;      /* game columns share the width equally (the name column below is fixed) */
        min-width: 70px;
        padding: 4px;
        overflow: hidden;
    }

    /* The on-screen "Printer Friendly View" tables stay compact (fixed 70px columns), not stretched. */
    .matrix-table.custom-print-table { width: auto; }
    .matrix-table.custom-print-table th,
    .matrix-table.custom-print-table td { width: 70px; min-width: 70px; max-width: 70px; }

    /* 4. STICKY HEADERS (Top Row) */
    .matrix-table th {
        position: sticky;
        top: 0;
        z-index: 20; 
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
        padding: 0.5rem;
        box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1);
        white-space: normal; /* ALLOW WRAP */
        height: auto;
        font-size: 0.75rem;
        line-height: 1.1;
    }

    /* 5. STICKY FIRST COLUMN (Left Column) */
    .matrix-table td.sticky-col, .matrix-table th.sticky-col-header  {
        position: sticky;
        left: 0;
        z-index: 10; 
        background-color: #fff !important; 
        border-right: 2px solid #dee2e6;
        font-weight: 500;
        width: 180px;      /* FIXED WIDTH FOR NAMES */
        min-width: 180px;
        max-width: 180px;
        text-align: left; /* Align names left */
        box-shadow: 2px 0 2px -1px rgba(0, 0, 0, 0.1);
    }
    .matrix-table th.sticky-col-header {
        z-index: 30; /* Corner overlap */
        background-color: #e9ecef !important;
        text-align: center;
    }

    /* 7. ROW HOVER */
    .matrix-table tr:hover td { background-color: #f1f3f5; }
    .matrix-table tr:hover td.sticky-col { background-color: #e9ecef !important; }

    /* Sim Controls */
    .sim-control-btn {
        cursor: pointer;
        padding: 2px;
        border-radius: 4px;
        border: 1px solid #ced4da;
        margin: 2px auto;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 28px;
        background-color: white;
    }
    .sim-control-btn:hover { filter: brightness(0.95); background-color: #e9ecef; }
    .sim-control-btn.active-win {
        background-color: #d1e7dd; 
        border-color: #198754;
        box-shadow: inset 0 0 0 1px #198754;
    }
    .sim-control-btn.active-loss {
        opacity: 0.4;
        background-color: #f8d7da;
    }
    
    /* Colors */
    .cell-win { background-color: #d1e7dd !important; color: #0f5132; }
    .cell-loss { background-color: #f8d7da !important; color: #842029; opacity: 0.6; }

    .team-logo-sm { width: 18px; height: 18px; object-fit: contain; margin-right: 2px; }
    .team-abbrev { font-size: 0.75rem; font-weight: bold; }

    @@media print {
        @@page { size: landscape; margin: 0.5cm; }
        
        /* Hide Navigation & Layout */
        .sidebar, .top-row, .navbar, header, footer { display: none !important; }
        
        /* Layout Resets */
        .container-fluid {
            width: 100% !important;
            max-width: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Matrix Container: Remove scroll & constraints */
        .matrix-container {
            height: auto !important;
            overflow: visible !important;
            border: none !important;
            width: 100% !important;
            max-width: none !important;
            display: block !important;
        }

        /* Table: Allow full width & wrapping */
        .matrix-table {
            width: 100% !important;
            table-layout: auto !important;
        }

        /* Cells & Headers: Reduce size & remove stickiness */
        .matrix-table th, 
        .matrix-table td {
            position: static !important; /* Remove sticky */
            font-size: 8pt !important;   /* Reduce text size */
            padding: 1px !important;     /* Tighter padding */
            width: auto !important;      /* Allow automatic sizing */
            min-width: 0 !important;
            max-width: none !important; /* Uncap width */
            border: 1px solid #000 !important; /* High contrast borders */
        }
        
        /* Remove specific sticky styles */
        .sticky-col, .sticky-col-header {
            position: static !important;
            border: 1px solid #000 !important;
            box-shadow: none !important;
        }

        /* Visual Tweaks for Print */
        .team-logo-sm { width: 12px !important; height: 12px !important; margin-right: 1px !important; }
        .team-abbrev { font-size: 7pt !important; }
        .badge { border: none !important; padding: 0 !important; font-size: 7pt !important; }
        
        /* Force background colors */
        .cell-win, .cell-loss, .active-win, .active-loss {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }
</style>

@*
    Release 2 group E: the default view is "Who can still win, and what has to happen" (owner decisions 2026-11-28:
    contenders are the entries that can still finish top 3, each with the open picks where it differs from the leader
    ("can win" when its score plus those games' points reaches the leader's score; your own out entry is marked "You"),
    three shown and the rest one tap away; the full grid is the second tab, ?view=grid). Both views draw only
    BracketSimulator's output; the summary lines come from PathToVictory (Core). Only locked pools are listed
    (PathToVictory.ShowsPool), so no picks show before lock.
*@
<div class="container-fluid mt-3 px-3 px-md-4">
    <PageHeader Title="Path to Victory" Subtitle="@SelectedPool?.Name">
        <Actions>
            <PoolSwitcher Mode="PoolSwitcherMode.Segmented" />
        </Actions>
    </PageHeader>

    @if (!isLoading && poolList.Any())
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-3 no-print">
            <div class="bm-segmented" role="group" aria-label="View">
                <button type="button" aria-pressed="@(ShowGrid ? "false" : "true")" @onclick="() => ShowViewAsync(false)">Who can win</button>
                <button type="button" aria-pressed="@(ShowGrid ? "true" : "false")" @onclick="() => ShowViewAsync(true)">Full grid</button>
            </div>

            @if (ShowGrid)
            {
                <div class="d-flex gap-2">
                    @if (HasActiveSimulation && !isPrintView)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="ResetSimulation">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset to Reality
                        </button>
                    }

                    <button class="btn btn-sm @(isPrintView ? "btn-secondary" : "btn-outline-secondary") d-print-none"
                            @onclick="() => isPrintView = !isPrintView">
                        <i class="bi @(isPrintView ? "bi-table" : "bi-printer")"></i>
                        @(isPrintView ? "Exit Print View" : "Printer Friendly View")
                    </button>
                </div>
            }
        </div>
    }

    @if (ShowGrid && isPrintView)
    {
        <div class="d-print-none alert alert-info py-2 mb-3">
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>Printer Friendly Mode Active:</strong> The table has been split into smaller chunks to fit on standard paper. Use <code>Ctrl+P</code> to print.
        </div>
    }

    @if (isLoading)
    {
        <LoadingIndicator Text="Loading Path to Victory..." />
    }
    else if (!poolList.Any())
    {
        <EmptyState Title="Awaiting Kickoff" Icon="@Icons.Material.Outlined.HourglassEmpty">
            <ChildContent>Path to Victory unlocks when the first pool of the season opens.</ChildContent>
        </EmptyState>
    }
    else if (!ShowGrid)
    {
        @if (HasActiveSimulation)
        {
            <Notice Tone="NoticeTone.Tip" Title="Includes the winners you chose on the full grid.">
                <SecondaryButton OnClick="ResetSimulation" Icon="@Icons.Material.Outlined.Undo">Reset to real results</SecondaryButton>
            </Notice>
        }

        @if (!summary.Contenders.Any())
        {
            <EmptyState Title="No entries yet" Icon="@Icons.Material.Outlined.EmojiEvents">
                <ChildContent>No entries found for <strong>@(SelectedPool?.Name ?? "this pool")</strong>.</ChildContent>
            </EmptyState>
        }
        else
        {
            <h2 class="bm-section-title">Still in the running (@summary.Contenders.Count)</h2>
            <MudGrid Spacing="3" Class="mt-1">
                @foreach (var line in summary.Contenders)
                {
                    var id = line.Row.Entry.Id;
                    var mine = myEntryIds.Contains(id);
                    var expanded = expandedIds.Contains(id);
                    <MudItem xs="12" md="6" lg="4">
                        <Card Tone="@(mine ? CardTone.Highlight : CardTone.Default)" Eyebrow="@(mine ? "You" : null)"
                              AriaLabel="@($"{line.Row.Entry.PlayerName}, place {line.Row.Rank}")">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div style="min-width: 0">
                                    <span>@line.Row.Rank.</span>
                                    <strong>@line.Row.Entry.PlayerName</strong>
                                    @if (line.CanWin)
                                    {
                                        <span class="ms-1"><Badge Tone="BadgeTone.Good">can win</Badge></span>
                                    }
                                </div>
                                <div class="text-end text-nowrap">
                                    <strong>@line.Row.Score pts</strong>
                                    <div class="bm-note">max @line.Row.MaxPossible</div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(line.GapText))
                            {
                                <div>@line.GapText</div>
                            }
                            @if (line.Swings.Any())
                            {
                                <div>
                                    <div class="bm-note">@line.SwingsLabel:</div>
                                    <ul class="mb-0 ps-3">
                                        @foreach (var swing in expanded ? line.Swings : line.Swings.Take(line.ShownByDefault))
                                        {
                                            <li>@swing.Text</li>
                                        }
                                    </ul>
                                </div>
                                @if (line.HiddenByDefault > 0)
                                {
                                    <div>
                                        <SecondaryButton OnClick="() => ToggleExpanded(id)">
                                            @(expanded ? "Show fewer" : $"+ {line.HiddenByDefault} more")
                                        </SecondaryButton>
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrEmpty(line.NoSwingsText))
                            {
                                <div class="bm-note">@line.NoSwingsText</div>
                            }
                        </Card>
                    </MudItem>
                }
            </MudGrid>

            @if (summary.Out.Any())
            {
                <div class="mt-3">
                    <SecondaryButton OnClick="() => showOut = !showOut">
                        @OutButtonText
                    </SecondaryButton>
                </div>
                @if (showOut)
                {
                    <ul class="list-unstyled mt-2 mb-0">
                        @foreach (var row in summary.Out)
                        {
                            <li class="py-1">
                                @row.Rank. @row.Entry.PlayerName · @row.Score pts <span class="bm-note">· max @row.MaxPossible</span>
                                @if (myEntryIds.Contains(row.Entry.Id))
                                {
                                    <Badge Tone="BadgeTone.Good">You</Badge>
                                }
                                <Badge>out</Badge>
                            </li>
                        }
                    </ul>
                }
            }
        }
    }
    else if (isPrintView)
    {
        @* PRINT VIEW: Split Table *@
        <div class="print-container">
            @foreach (var chunk in GetGameChunks())
            {
                <div class="mb-4 break-after-page">
                    <table class="table table-bordered table-sm matrix-table custom-print-table">
                        <thead>
                            <tr>
                                <th style="width: 150px;">Player</th>
                                @foreach (var game in chunk)
                                {
                                    <th class="text-center">
                                        <div class="small fw-bold text-truncate" style="max-width: 60px;">@game.BowlName</div>
                                        <div class="badge bg-light text-secondary border">@game.PointValue</div>
                                        <div class="d-block mt-1" style="font-size: 0.65rem;">
                                            @if(EffectiveWinner(game.Id) is { } w)
                                            {
                                                <span class="badge bg-success text-white">@GetTeamAbbrev(w)</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in projectedStandings)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-truncate" style="max-width: 110px;">@row.Entry.PlayerName</span>
                                            <span class="badge bg-primary rounded-pill">@row.Score</span>
                                        </div>
                                    </td>
                                    @foreach (var game in chunk)
                                    {
                                        var pick = row.Entry.Picks != null && row.Entry.Picks.ContainsKey(game.Id) ? row.Entry.Picks[game.Id] : "";
                                        <td class="text-center @GetCellClass(game, row, pick)">
                                            @if (!string.IsNullOrEmpty(pick))
                                            {
                                                <span class="fw-bold" style="font-size: 0.7rem;">@GetTeamAbbrev(pick)</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <div class="matrix-container shadow-sm">
            <table class="table mb-0 matrix-table table-bordered" style="--matrix-min-width: @(180 + games.Count * 70)px">
                <thead>
                    <tr>
                        <th class="sticky-col-header">
                            <div class="d-flex justify-content-between text-muted small px-1">
                                <span>Player</span>
                                <span>Proj.</span>
                            </div>
                        </th>
                        @foreach (var game in games)
                        {
                            <th>
                                <div class="fw-bold mb-1 text-truncate" title="@game.BowlName">
                                    @game.BowlName
                                </div>
                                <div class="badge bg-light text-secondary border mb-1" style="font-size: 0.65rem;">@game.PointValue</div>
                                
                                @{
                                    var options = GetSelectableTeams(game);
                                }
                                
                                @if(options.Count <= 2) 
                                {
                                    <div class="d-flex flex-column gap-1">
                                        @foreach(var teamName in options)
                                        {
                                            var logo = GetTeamLogo(teamName);
                                            var abbr = GetTeamAbbrev(teamName);
                                            <div class="sim-control-btn @GetSimClass(game.Id, teamName, options)" 
                                                 title="@teamName"
                                                 @onclick="() => ToggleSimWinner(game.Id, teamName)">
                                                @if(!string.IsNullOrEmpty(logo))
                                                {
                                                    <img src="@logo" class="team-logo-sm" />
                                                }
                                                <span class="team-abbrev">@abbr</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm p-1" style="font-size: 0.65rem;" 
                                            value="@(EffectiveWinner(game.Id) ?? "")"
                                            @onchange="@(e => SetSimWinner(game.Id, e.Value?.ToString()))">
                                        <option value="">?</option>
                                        @foreach(var teamName in options)
                                        {
                                            <option value="@teamName">@GetTeamAbbrev(teamName)</option>
                                        }
                                    </select>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in projectedStandings)
                    {
                        <tr class="@(row.CanFinishTop3 ? "" : "opacity-50")">
                            <td class="sticky-col">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-truncate" style="max-width: 160px;" title="@row.Entry.PlayerName">
                                        <span class="text-muted small me-1">@row.Rank.</span>
                                        @row.Entry.PlayerName
                                    </span>
                                    @if (!row.CanFinishTop3)
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" style="font-size:0.75rem;" title="Cannot finish in top 3"></i>
                                    }
                                    <span class="badge bg-primary rounded-pill">@row.Score</span>
                                </div>
                            </td>

                            @foreach (var game in games)
                            {
                                var pick = row.Entry.Picks != null && row.Entry.Picks.ContainsKey(game.Id) ? row.Entry.Picks[game.Id] : "";
                                <td class="@GetCellClass(game, row, pick)">
                                    @if (!string.IsNullOrEmpty(pick))
                                    {
                                        var logo = GetTeamLogo(pick);
                                        var abbr = GetTeamAbbrev(pick);
                                        <div class="d-flex align-items-center justify-content-center" title="@pick">
                                            @if(!string.IsNullOrEmpty(logo))
                                            {
                                                <img src="@logo" class="team-logo-sm" />
                                            }
                                            <span class="team-abbrev">@abbr</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private List<BowlGame> games = new();
    private List<BowlGame> allGames = new();
    
    // Raw Data
    private List<BracketEntry> allEntries = new();
    private List<BowlPool> poolList = new();
    
    // Filtered State
    private string selectedPoolId = "";
    private List<BracketEntry> filteredEntries = new();
    
    // Print View State
    private bool isPrintView = false;
    private const int PRINT_CHUNK_SIZE = 15;

    private IEnumerable<List<BowlGame>> GetGameChunks()
    {
        return games
            .Select((x, i) => new { Index = i, Value = x })
            .GroupBy(x => x.Index / PRINT_CHUNK_SIZE)
            .Select(x => x.Select(v => v.Value).ToList());
    }
    
    // ========== SIMULATION ==========
    // All of the bracket logic lives in BracketSimulator (Core). The page keeps the user's choices and draws the result.

    // User's explicit simulation choices. Real results apply to every game the user has not chosen.
    private Dictionary<string, string> _userSimulations = new();

    private SimulationResult _sim = new();

    // Leaderboard projection (same order and ranks as the leaderboard)
    private List<SimulatedRow> projectedStandings = new();

    // Cache for efficient Team Info Lookup
    private Dictionary<string, TeamInfo> teamLookup = new(StringComparer.OrdinalIgnoreCase);

    // Game lookup by ID for fast access
    private Dictionary<string, BowlGame> _gameById = new();
    
    [SupplyParameterFromQuery(Name = "poolId")]
    public string? QueryPoolId { get; set; }
    
    private string currentSeasonId = "";

    protected override async Task OnInitializedAsync()
    {
        PoolSelection.Changed += OnPoolSelectionChanged;

        try
        {
            // 0. Fetch Current Season
            var currentSeason = await SeasonService.GetCurrentSeasonAsync();
            currentSeasonId = currentSeason?.Id ?? "";

            var gamesTask = Http.GetFromJsonAsync<List<BowlGame>>($"api/GetGames?seasonId={currentSeasonId}");
            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>($"api/GetPools?seasonId={currentSeasonId}");
            var myEntriesTask = FetchMyEntriesSafe();

            await Task.WhenAll(gamesTask, poolsTask, myEntriesTask);

            allGames = (await gamesTask ?? new()).OrderBy(g => g.StartTime).ToList();
            games = allGames.ToList();
            var allPools = await poolsTask ?? new();
            var myEntries = await myEntriesTask;

            // 1. Only pools that have locked: both views draw every entry's picks (BUSINESS-RULES section 3).
            poolList = allPools.Where(p => PathToVictory.ShowsPool(p, DateTime.UtcNow)).ToList();

            // The entries endpoint wants a season and a pool, so ask once per open pool.
            var entryLists = await Task.WhenAll(poolList.Select(p =>
                Http.GetFromJsonAsync<List<BracketEntry>>($"api/GetEntries?seasonId={currentSeasonId}&poolId={p.Id}")));
            allEntries = entryLists.SelectMany(l => l ?? new()).ToList();

            // 2. Build lookup structures
            _gameById = allGames.ToDictionary(g => g.Id);
            
            foreach (var g in allGames)
            {
                // Populate team lookup
                if (!string.IsNullOrEmpty(g.TeamHome) && g.HomeTeamInfo != null) 
                    teamLookup[g.TeamHome] = g.HomeTeamInfo;
                if (!string.IsNullOrEmpty(g.TeamAway) && g.AwayTeamInfo != null) 
                    teamLookup[g.TeamAway] = g.AwayTeamInfo;
            }

            // 4. Which pool first: address, then this browser's last choice, then the newest entry, then the first pool.
            var latestEntry = myEntries.OrderByDescending(e => e.CreatedOn).FirstOrDefault();
            selectedPoolId = PoolPicker.Pick(poolList.Select(p => p.Id).ToList(), QueryPoolId,
                string.IsNullOrEmpty(QueryPoolId) ? await PoolSelection.GetSavedIdAsync() : null, latestEntry?.PoolId) ?? "";
            PoolSelection.Show(poolList.Select(p => new PoolChoice(p.Id, p.Name)).ToList(), selectedPoolId);

            // Entries to mark "You": the signed-in player's own, and the one this browser remembers per pool.
            signedInEntryIds = myEntries.Select(e => e.Id).ToHashSet();
            memory = await MyEntryStore.LoadAsync();

            UpdateFilteredEntries();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally { isLoading = false; }
    }

    private async Task<List<BracketEntry>> FetchMyEntriesSafe()
    {
        try 
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated == true)
            {
                return await Http.GetFromJsonAsync<List<BracketEntry>>($"api/GetMyEntries?seasonId={currentSeasonId}") ?? new();
            }
        }
        catch { }
        return new();
    }

    // --- FILTERING LOGIC ---

    // The visitor tapped a pool in the header or the page switcher (PoolSelection saves the choice in this browser).
    private void OnPoolSelectionChanged() => _ = InvokeAsync(() =>
    {
        var poolId = PoolSelection.CurrentId ?? "";
        if (poolId == selectedPoolId || poolList.All(p => p.Id != poolId)) return;
        selectedPoolId = poolId;
        expandedIds.Clear();
        UpdateFilteredEntries();
    });

    public void Dispose()
    {
        PoolSelection.Changed -= OnPoolSelectionChanged;
        PoolSelection.Clear();
    }

    // --- VIEW: "Who can win" (default) or the full grid (?view=grid) ---

    [SupplyParameterFromQuery(Name = "view")]
    public string? QueryView { get; set; }

    private bool ShowGrid => string.Equals(QueryView, "grid", StringComparison.OrdinalIgnoreCase);

    // The address keeps the tab, so Back returns to the other one.
    private Task ShowViewAsync(bool grid)
    {
        if (grid != ShowGrid)
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("view", grid ? "grid" : null));
        return Task.CompletedTask;
    }

    private PathToVictoryView summary = new();
    private readonly HashSet<string> expandedIds = new();
    private bool showOut;
    private HashSet<string> signedInEntryIds = new();
    private MyEntryMemory memory = new();
    private HashSet<string> myEntryIds = new();

    private BowlPool? SelectedPool => poolList.FirstOrDefault(p => p.Id == selectedPoolId);

    private string OutButtonText => (showOut ? "Hide: " : "") + (summary.Out.Count == 1
        ? "1 entry can't finish top 3"
        : $"{summary.Out.Count} entries can't finish top 3");

    private void ToggleExpanded(string entryId)
    {
        if (!expandedIds.Remove(entryId)) expandedIds.Add(entryId);
    }

    private void UpdateFilteredEntries()
    {
        if (string.IsNullOrEmpty(selectedPoolId))
        {
            filteredEntries = new();
            games = allGames.ToList();
        }
        else
        {
            filteredEntries = allEntries.Where(e => e.PoolId == selectedPoolId).ToList();
            
            var pool = poolList.FirstOrDefault(p => p.Id == selectedPoolId);
            if (pool != null && pool.GameIds != null && pool.GameIds.Any())
            {
                games = allGames.Where(g => pool.GameIds.Contains(g.Id)).OrderBy(g => g.StartTime).ToList();
            }
            else
            {
                games = allGames.ToList();
            }
        }
        RecomputeSimulationState();
    }

    // ========== CORE SIMULATION LOGIC ==========

    private void RecomputeSimulationState()
    {
        var pool = poolList.FirstOrDefault(p => p.Id == selectedPoolId);
        _sim = BracketSimulator.Run(games, filteredEntries, pool, _userSimulations);
        projectedStandings = _sim.Rows;
        summary = PathToVictory.Summarize(_sim, games);

        myEntryIds = signedInEntryIds.ToHashSet();
        if (memory.Get(selectedPoolId) is { } remembered) myEntryIds.Add(remembered.EntryId);
        StateHasChanged();
    }

    private string? EffectiveWinner(string gameId) =>
        _sim.Games.TryGetValue(gameId, out var g) ? g.Winner : null;

    // --- INTERACTION ---

    private void ToggleSimWinner(string gameId, string team)
    {
        if (_userSimulations.TryGetValue(gameId, out var current) && current == team)
        {
            _userSimulations.Remove(gameId);
        }
        else
        {
            _userSimulations[gameId] = team;
        }

        // Clear downstream user choices (they depend on this game's outcome)
        ClearDownstreamChoices(gameId);
        
        RecomputeSimulationState();
    }

    private void SetSimWinner(string gameId, string? team)
    {
        if (string.IsNullOrEmpty(team))
            _userSimulations.Remove(gameId);
        else
            _userSimulations[gameId] = team;
            
        ClearDownstreamChoices(gameId);
        RecomputeSimulationState();
    }

    private void ClearDownstreamChoices(string gameId)
    {
        if (!_gameById.TryGetValue(gameId, out var game) || string.IsNullOrEmpty(game.NextGameId))
            return;
        
        _userSimulations.Remove(game.NextGameId);
        ClearDownstreamChoices(game.NextGameId);
    }

    private void ResetSimulation()
    {
        _userSimulations.Clear();
        
        RecomputeSimulationState();
    }

    // --- SIMPLE STYLING HELPERS (read from pre-computed state) ---

    private bool HasActiveSimulation
    {
        get
        {
            // A decided game whose winner is not the real result is a simulation (a prediction or changed history).
            return _sim.Games.Values.Any(g => g.Winner != null && !g.WinnerIsReal);
        }
    }

    private List<string> GetSelectableTeams(BowlGame game)
    {
        if (_sim.Games.TryGetValue(game.Id, out var sim))
            return sim.Entrants.OrderBy(t => t).ToList();
        return new List<string>();
    }

    private string GetSimClass(string gameId, string team, List<string> validOptions)
    {
        var winner = EffectiveWinner(gameId);
        if (winner != null)
        {
            if (validOptions.Contains(winner, StringComparer.OrdinalIgnoreCase))
            {
                return string.Equals(winner, team, StringComparison.OrdinalIgnoreCase) ? "active-win" : "active-loss";
            }
        }
        return "bg-white";
    }

    private string GetCellClass(BowlGame game, SimulatedRow row, string pick)
    {
        if (string.IsNullOrEmpty(pick)) return "";

        if (row.Picks.TryGetValue(game.Id, out var state))
        {
            if (state == PickState.Won) return "cell-win";
            if (state == PickState.Lost || state == PickState.Dead) return "cell-loss";
        }

        // Undecided: a team that cannot reach this game is out.
        if (_sim.Games.TryGetValue(game.Id, out var sim) && !sim.Entrants.Contains(pick, StringComparer.OrdinalIgnoreCase))
            return "cell-loss";

        return "";
    }
    
    private string GetTeamLogo(string teamName)
    {
        if (string.IsNullOrEmpty(teamName)) return "";
        return teamLookup.TryGetValue(teamName, out var info) ? info.PrimaryLogoUrl : "";
    }

    private string GetTeamAbbrev(string teamName)
    {
        if (string.IsNullOrEmpty(teamName)) return "";
        if (teamLookup.TryGetValue(teamName, out var info) && !string.IsNullOrEmpty(info.Abbreviation)) 
            return info.Abbreviation;
        if (teamName.Length > 4 && !teamName.Contains(" ")) 
            return teamName.Substring(0, 3).ToUpper();
        return teamName;
    }
}
