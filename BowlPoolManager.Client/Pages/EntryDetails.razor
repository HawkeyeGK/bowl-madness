@page "/entry/{EntryId}"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core
@using BowlPoolManager.Core.Helpers
@using BowlPoolManager.Client.Services
@using BowlPoolManager.Client.Helpers
@using MudBlazor
@inject ISeasonService SeasonService
@inject HttpClient Http

@*
    Release 2 Entry details: one entry's picks as MatchupCards, grouped Bowl games then each playoff round, each pick marked
    right, wrong or pending. Later-round teams come from the entry's own earlier picks (BracketHelper.ResolveMatchup).
    The server hides other players' picks until the pool locks; this page also shows nothing before then.
*@

<PageContainer>
    <PageHeader Title="@(entry?.PlayerName ?? "Entry")"
                DocumentTitle="@(entry == null ? "Entry" : entry.PlayerName + " - picks")"
                Subtitle="@currentPool?.Name"
                Status="@StatusText"
                StatusIcon="@Icons.Material.Outlined.Schedule">
        <Actions>
            <span class="bm-only-phone"><SecondaryButton Href="@BackHref" Icon="@Icons.Material.Outlined.ArrowBack" IconOnly="true">Leaderboard</SecondaryButton></span>
            <span class="bm-only-wide"><SecondaryButton Href="@BackHref" Icon="@Icons.Material.Outlined.ArrowBack">Leaderboard</SecondaryButton></span>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <LoadingIndicator Text="Loading the picks..." />
    }
    else if (entry == null)
    {
        <EmptyState Title="Entry not found" Icon="@Icons.Material.Outlined.SearchOff">
            <ChildContent>This entry may have been deleted or the link is wrong.</ChildContent>
            <Action><PrimaryButton Href="leaderboard">Back to the Leaderboard</PrimaryButton></Action>
        </EmptyState>
    }
    else if (entry.Picks == null || (currentPool != null && DateTime.UtcNow < currentPool.LockDate))
    {
        <EmptyState Title="Picks are hidden until the pool locks" Icon="@Icons.Material.Outlined.Lock">
            <ChildContent>Everyone's picks show here once picks lock, so nobody can copy another bracket.</ChildContent>
            <Action>
                <AuthorizeView Roles="@Constants.Roles.SuperAdmin">
                    <Authorized>
                        <SecondaryButton Href="@($"admin/entry/{entry.Id}")" Icon="@Icons.Material.Outlined.Edit">Edit picks (admin)</SecondaryButton>
                    </Authorized>
                </AuthorizeView>
            </Action>
        </EmptyState>
    }
    else
    {
        <Card Tone="CardTone.Highlight">
            <MudStack Row="true" Justify="Justify.SpaceAround" AlignItems="AlignItems.Center" Spacing="2">
                <MudStack AlignItems="AlignItems.Center" Spacing="0">
                    <span class="bm-note">Points</span>
                    <MudText Typo="Typo.h4">@currentScore</MudText>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center" Spacing="0">
                    <span class="bm-note">Max possible</span>
                    <MudText Typo="Typo.h4">@maxPossible</MudText>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center" Spacing="0">
                    <span class="bm-note">Tiebreaker</span>
                    <MudText Typo="Typo.h4">@entry.TieBreakerPoints</MudText>
                </MudStack>
            </MudStack>
            <AuthorizeView Roles="@Constants.Roles.SuperAdmin">
                <Authorized>
                    <div><SecondaryButton Href="@($"admin/entry/{entry.Id}")" Icon="@Icons.Material.Outlined.Edit">Edit picks (admin)</SecondaryButton></div>
                </Authorized>
            </AuthorizeView>
        </Card>

        @foreach (var block in Sections())
        {
            <h2 class="bm-section-title">@block.Title</h2>
            <MudGrid Spacing="2">
                @foreach (var game in block.Games)
                {
                    <MudItem xs="12" md="6" lg="4" @key="game.Id">
                        <MatchupCard BowlName="@game.BowlName"
                                     PointsText="@ScoreGameText.PointsText(game)"
                                     Status="@StatusOf(game)"
                                     StatusText="@ScoreGameText.StatusText(game, DateTime.UtcNow)"
                                     Away="@TeamOf(game, false)"
                                     Home="@TeamOf(game, true)"
                                     Pick="@PickOf(game)"
                                     Where="@WhereOf(game)" />
                    </MudItem>
                }
            </MudGrid>
        }
    }
</PageContainer>

@code {
    [Parameter] public string EntryId { get; set; } = string.Empty;
    private bool isLoading = true;
    private BracketEntry? entry;
    private List<BowlGame> games = new();
    private int currentScore = 0;
    private int maxPossible = 0;
    private string currentSeasonId = "";
    private HashSet<string> eliminatedTeams = new(StringComparer.OrdinalIgnoreCase);
    private BowlPool? currentPool;
    private DateTime lastUpdate = DateTime.MinValue;

    private string BackHref => entry == null ? "leaderboard" : $"leaderboard?poolId={Uri.EscapeDataString(entry.PoolId)}";

    private string? StatusText => currentPool == null
        ? null
        : StatusLineText.ForPool(DateTime.UtcNow, currentPool.LockDate, lastUpdate == DateTime.MinValue ? null : lastUpdate,
            games.Count(g => g.IsFinal), games.Count);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentSeason = await SeasonService.GetCurrentSeasonAsync();
            currentSeasonId = currentSeason?.Id ?? "";

            var gamesTask = Http.GetFromJsonAsync<List<BowlGame>>($"api/GetGames?seasonId={currentSeasonId}");
            var entryTask = FetchEntryAsync();
            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>($"api/GetPools?seasonId={currentSeasonId}");
            await Task.WhenAll(gamesTask, entryTask, poolsTask);

            var allGames = await gamesTask ?? new();
            var allPools = await poolsTask ?? new();

            // The server hides other players' picks until the pool locks.
            entry = await entryTask;

            if (entry != null)
            {
                currentPool = allPools.FirstOrDefault(p => p.Id == entry.PoolId);

                games = currentPool?.GameIds is { Count: > 0 } ids
                    ? allGames.Where(g => ids.Contains(g.Id)).ToList()
                    : allGames.ToList();

                foreach (var g in games.Where(x => x.IsFinal))
                {
                    if (!string.IsNullOrEmpty(g.LosingTeamName)) eliminatedTeams.Add(g.LosingTeamName);
                }

                if (entry.Picks != null)
                {
                    var stats = ScoringEngine.Calculate(games, new List<BracketEntry> { entry }).First();
                    currentScore = stats.Score;
                    maxPossible = stats.MaxPossible;
                }
            }

            try { lastUpdate = await Http.GetFromJsonAsync<DateTime>("api/GetLastScoreUpdate"); }
            catch { /* the status line just leaves it out */ }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading entry: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    // One entry by id. A missing entry (404) leaves the page on its "not found" view.
    private async Task<BracketEntry?> FetchEntryAsync()
    {
        var response = await Http.GetAsync($"api/GetEntry?id={Uri.EscapeDataString(EntryId)}&seasonId={currentSeasonId}");
        return response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<BracketEntry>() : null;
    }

    private record Section(string Title, List<BowlGame> Games);

    // Bowl games first, then each playoff round, each in kickoff order.
    private IEnumerable<Section> Sections()
    {
        var standard = games.Where(g => !g.IsPlayoff).OrderBy(g => g.StartTime).ToList();
        if (standard.Count > 0) yield return new Section("Bowl games", standard);

        foreach (var (round, title) in new[]
        {
            (TournamentRound.Round1, "Playoff: first round"), (TournamentRound.QuarterFinal, "Playoff: quarterfinals"),
            (TournamentRound.SemiFinal, "Playoff: semifinals"), (TournamentRound.Championship, "Playoff: championship")
        })
        {
            var inRound = games.Where(g => g.IsPlayoff && g.Round == round).OrderBy(g => g.StartTime).ToList();
            if (inRound.Count > 0) yield return new Section(title, inRound);
        }

        // A playoff game with an unexpected round still shows.
        var other = games.Where(g => g.IsPlayoff && g.Round is not (TournamentRound.Round1 or TournamentRound.QuarterFinal or TournamentRound.SemiFinal or TournamentRound.Championship))
            .OrderBy(g => g.StartTime).ToList();
        if (other.Count > 0) yield return new Section("Playoff", other);
    }

    private static MatchupStatus StatusOf(BowlGame game) => game.Status switch
    {
        GameStatus.InProgress => MatchupStatus.Live,
        GameStatus.Final => MatchupStatus.Final,
        _ => MatchupStatus.Scheduled
    };

    // The teams as this entry sees them: later rounds show the teams its own earlier picks lead to.
    private MatchupTeam TeamOf(BowlGame game, bool isHome)
    {
        var slots = BracketHelper.ResolveMatchup(game, entry!.Picks, games);
        var name = isHome ? slots.Home : slots.Away;
        var storedName = isHome ? game.TeamHome : game.TeamAway;
        var isStored = string.Equals(name, storedName, StringComparison.OrdinalIgnoreCase);
        var info = VisualHelper.GetTeamInfo(name, game, games);
        var winner = game.IsFinal ? game.WinningTeamName : null;

        return new MatchupTeam(
            name,
            info,
            ApRank: isStored ? (isHome ? game.HomeApRank : game.AwayApRank) : null,
            Seed: isStored ? (isHome ? game.TeamHomeSeed : game.TeamAwaySeed) : null,
            Score: isHome ? game.TeamHomeScore : game.TeamAwayScore,
            Decided: !BracketSlots.IsPlaceholder(name),
            Won: winner != null && string.Equals(winner, name, StringComparison.OrdinalIgnoreCase));
    }

    private MatchupPick PickOf(BowlGame game)
    {
        entry!.Picks!.TryGetValue(game.Id, out var pick);
        var line = PickLine.For(game, pick, null, eliminatedTeams);
        return new MatchupPick(line.Text, line.Outcome);
    }

    private static string? WhereOf(BowlGame game)
    {
        var text = string.Join(" · ", new[] { game.Television, game.Location }.Where(p => !string.IsNullOrWhiteSpace(p)));
        return text.Length == 0 ? null : text;
    }
}
