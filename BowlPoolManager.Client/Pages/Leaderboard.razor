@page "/"
@page "/leaderboard"
@implements IDisposable
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core.Dtos
@using BowlPoolManager.Core
@using BowlPoolManager.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject ISeasonService SeasonService
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISiteContext SiteContext
@inject PoolSelection PoolSelection

@*
    Release 2 reference page: the Leaderboard built only from the shared components in Client/Ui.
    Later pages copy this pattern. Logic that is not drawing lives in Core: StatusLineText, TopThreeRule, PoolPicker.
*@

<PageContainer>
    <PageHeader Title="Leaderboard"
                Subtitle="@currentPool?.Name"
                Status="@StatusText"
                StatusIcon="@Icons.Material.Outlined.Schedule">
        <Actions>
            <PoolSwitcher Mode="PoolSwitcherMode.Segmented" />
            <span class="bm-only-phone">
                <SecondaryButton Href="print-bracket" Icon="@Icons.Material.Outlined.Print" IconOnly="true">Print Bracket</SecondaryButton>
            </span>
            <span class="bm-only-wide">
                <SecondaryButton Href="print-bracket" Icon="@Icons.Material.Outlined.Print">Print Bracket</SecondaryButton>
            </span>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <LoadingIndicator Text="Loading the standings..." />
    }
    else if (leaderboard == null || !leaderboard.Any())
    {
        <EmptyState Title="No entries yet" Icon="@Icons.Material.Outlined.EmojiEvents">
            <ChildContent>No entries found for <strong>@(currentPool?.Name ?? "this pool")</strong>.</ChildContent>
        </EmptyState>
    }
    else
    {
        <DataTable Label="Leaderboard">
            <TableHeader Columns="@PhoneColumns" ColumnsWide="@WideColumns">
                <TableHeaderCell Text="#" OnSort="@(() => Sort("Rank"))" SortActive="@(sortColumn == "Rank")" Ascending="isAscending" Hint="Rank" />
                <TableHeaderCell Text="Name" OnSort="@(() => Sort("Player"))" SortActive="@(sortColumn == "Player")" Ascending="isAscending" />
                <TableHeaderCell Text="Points" End="true" OnSort="@(() => Sort("Score"))" SortActive="@(sortColumn == "Score")" Ascending="isAscending" />
                <TableHeaderCell Text="Max" End="true" Hint="Maximum possible score" OnSort="@(() => Sort("Max"))" SortActive="@(sortColumn == "Max")" Ascending="isAscending" />
                <TableHeaderCell Text="Correct" End="true" HidePhone="true" OnSort="@(() => Sort("Correct"))" SortActive="@(sortColumn == "Correct")" Ascending="isAscending" />
                <TableHeaderCell Text="Bowls" End="true" HidePhone="true" OnSort="@(() => Sort("Bowls"))" SortActive="@(sortColumn == "Bowls")" Ascending="isAscending" />
                <TableHeaderCell Text="1st Rd" End="true" HidePhone="true" OnSort="@(() => Sort("Round1"))" SortActive="@(sortColumn == "Round1")" Ascending="isAscending" />
                <TableHeaderCell Text="Quarters" End="true" HidePhone="true" OnSort="@(() => Sort("QuarterFinal"))" SortActive="@(sortColumn == "QuarterFinal")" Ascending="isAscending" />
                <TableHeaderCell Text="Semis" End="true" HidePhone="true" OnSort="@(() => Sort("SemiFinal"))" SortActive="@(sortColumn == "SemiFinal")" Ascending="isAscending" />
                <TableHeaderCell Text="Final" End="true" HidePhone="true" OnSort="@(() => Sort("Championship"))" SortActive="@(sortColumn == "Championship")" Ascending="isAscending" />
                <TableHeaderCell Text="Tiebreaker" End="true" HidePhone="true" OnSort="@(() => Sort("Tiebreaker"))" SortActive="@(sortColumn == "Tiebreaker")" Ascending="isAscending" />
            </TableHeader>
            @foreach (var row in leaderboard)
            {
                <TableRow Columns="@PhoneColumns" ColumnsWide="@WideColumns"
                          Href="@(picksHidden ? null : $"entry/{row.Id}")"
                          AriaLabel="@RowLabel(row)">
                    <TableCell Kind="CellKind.Rank">@row.Rank</TableCell>
                    <TableCell Kind="CellKind.Name">
                        @if (picksHidden)
                        {
                            <span>
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="vertical-align: -3px" Title="Picks are hidden until the pool locks" />
                                @row.PlayerName
                            </span>
                        }
                        else
                        {
                            <span>@row.PlayerName</span>
                            @if (isPoolFinal && row.Rank <= 3)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Style="@($"color: {TrophyColor(row.Rank)}")" Title="@TrophyTitle(row.Rank)" />
                            }
                            @if (outIds.Contains(row.Id))
                            {
                                <Badge>out</Badge>
                            }
                        }
                    </TableCell>
                    <TableCell Kind="CellKind.Points">@row.Score</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true">@row.MaxPossible</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@row.CorrectPicks/@totalFinalGames</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@row.RoundScores[TournamentRound.Standard]</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@row.RoundScores[TournamentRound.Round1]</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@row.RoundScores[TournamentRound.QuarterFinal]</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@row.RoundScores[TournamentRound.SemiFinal]</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@row.RoundScores[TournamentRound.Championship]</TableCell>
                    <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">
                        @if (picksHidden)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" Size="Size.Small" Title="Hidden until picks lock" />
                        }
                        else
                        {
                            @($"{row.TieBreakerPoints} pts")
                        }
                    </TableCell>
                </TableRow>
            }
        </DataTable>

        <div class="bm-note">
            @if (picksHidden)
            {
                <div><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="vertical-align: -3px" /> Picks are hidden until the pool locks, so names are not links yet.</div>
            }
            <div>Max = the most points still possible. "Out" means no longer able to finish in the top 3. Ties are broken by Max, then the pool's tiebreakers, then name.</div>
        </div>
    }
</PageContainer>

@code {
    // Phone: rank, name, points, max. Wide screens add the other columns (cells marked HidePhone).
    private const string PhoneColumns = "44px minmax(0, 1fr) 64px 52px";
    private const string WideColumns = "56px minmax(160px, 1.6fr) 80px 64px 80px 64px 64px 84px 64px 64px 104px";

    private bool isLoading = true;
    private List<BowlPool> pools = new();
    private BowlPool? currentPool;
    private List<LeaderboardDto> leaderboard = new();
    private HashSet<string> outIds = new();
    private int totalFinalGames = 0;
    private bool isPoolFinal = false;
    private DateTime LastUpdate = DateTime.MinValue;
    private string currentSeasonId = "";

    // Sorting
    private string sortColumn = "Score";
    private bool isAscending = false;

    [SupplyParameterFromQuery(Name = "poolId")]
    public string? QueryPoolId { get; set; }

    // Picks stay hidden until the pool locks (BUSINESS-RULES section 3); names are not links before then.
    private bool picksHidden => currentPool != null && DateTime.UtcNow <= currentPool.LockDate;

    private string? StatusText => currentPool == null
        ? null
        : StatusLineText.ForPool(DateTime.UtcNow, currentPool.LockDate,
            LastUpdate == DateTime.MinValue ? null : LastUpdate, totalFinalGames, currentPool.GameIds?.Count ?? 0);

    protected override async Task OnInitializedAsync()
    {
        await SiteContext.InitializeAsync();
        if (SiteContext.ActiveSport == Sport.Basketball)
        {
            Nav.NavigateTo("/hoops/leaderboard", replace: true);
            return;
        }

        PoolSelection.Changed += OnPoolSelectionChanged;

        try
        {
            isLoading = true;

            // 0. Fetch Current Season
            var currentSeason = await SeasonService.GetCurrentSeasonAsync();
            currentSeasonId = currentSeason?.Id ?? "";

            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>($"api/GetPools?seasonId={currentSeasonId}");
            var myEntriesTask = FetchMyEntriesSafe();

            await Task.WhenAll(poolsTask, myEntriesTask);
            var allPools = await poolsTask ?? new();

            var myEntries = await myEntriesTask;

            // Fetch the last update timestamp
            try {
                LastUpdate = await Http.GetFromJsonAsync<DateTime>("api/GetLastScoreUpdate");
            } catch { /* Ignore if fails */ }

            // CHECK FOR DIRECT LINK TO ARCHIVED POOL
            if (!string.IsNullOrEmpty(QueryPoolId))
            {
                var requestedPool = allPools.FirstOrDefault(p => p.Id == QueryPoolId);
                if (requestedPool != null && requestedPool.IsArchived)
                {
                    Nav.NavigateTo($"/history/{requestedPool.Id}");
                    return;
                }
            }

            // Only show active pools
            pools = allPools.Where(p => !p.IsArchived).ToList();

            // Which pool first: address, then this browser's last choice, then the newest entry, then the first pool.
            var latestEntry = myEntries.OrderByDescending(e => e.CreatedOn).FirstOrDefault();
            var chosenId = PoolPicker.Pick(pools.Select(p => p.Id).ToList(), QueryPoolId,
                string.IsNullOrEmpty(QueryPoolId) ? await PoolSelection.GetSavedIdAsync() : null, latestEntry?.PoolId);
            currentPool = pools.FirstOrDefault(p => p.Id == chosenId);

            PoolSelection.Show(pools.Select(p => new PoolChoice(p.Id, p.Name)).ToList(), currentPool?.Id);

            if (currentPool != null)
            {
                await LoadLeaderboardForPool(currentPool.Id);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading leaderboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<BracketEntry>> FetchMyEntriesSafe()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated == true)
            {
                return await Http.GetFromJsonAsync<List<BracketEntry>>($"api/GetMyEntries?seasonId={currentSeasonId}") ?? new();
            }
        }
        catch { /* Ignore auth errors on public page */ }
        return new();
    }

    // The visitor tapped a pool in the header or the page switcher.
    private void OnPoolSelectionChanged() => _ = InvokeAsync(OnPoolChosenAsync);

    private async Task OnPoolChosenAsync()
    {
        var poolId = PoolSelection.CurrentId;
        if (string.IsNullOrEmpty(poolId) || poolId == currentPool?.Id) return;

        var chosen = pools.FirstOrDefault(p => p.Id == poolId);
        if (chosen == null) return;

        currentPool = chosen;
        isLoading = true;
        StateHasChanged();
        await LoadLeaderboardForPool(chosen.Id);
        isLoading = false;
        StateHasChanged();
    }

    // Counts loads so a slow answer for a pool the visitor has already left cannot overwrite the newer one.
    private int loadVersion;

    private async Task LoadLeaderboardForPool(string poolId)
    {
        var version = ++loadVersion;
        try
        {
            // Call the new server-side GetLeaderboard API
            var response = await Http.GetFromJsonAsync<LeaderboardResponse>(
                $"api/GetLeaderboard?poolId={poolId}&seasonId={currentSeasonId}"
            );

            if (version != loadVersion) return;

            if (response != null)
            {
                leaderboard = response.Leaderboard ?? new();
                totalFinalGames = response.TotalFinalGames;

                // Determine if pool is final (all games complete): every entry's max equals its score.
                isPoolFinal = totalFinalGames > 0 && leaderboard.All(r => r.MaxPossible == r.Score);
            }
            else
            {
                leaderboard = new();
                totalFinalGames = 0;
                isPoolFinal = false;
            }

            // "Out" needs scores to mean something, so it shows only after the pool locks.
            outIds = picksHidden ? new() : TopThreeRule.OutEntryIds(leaderboard);

            Sort(sortColumn, forceToggle: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching leaderboard: {ex.Message}");
        }
    }

    // Response model for the GetLeaderboard API
    private class LeaderboardResponse
    {
        public int TotalFinalGames { get; set; }
        public List<LeaderboardDto>? Leaderboard { get; set; }
    }

    private static readonly Dictionary<string, Func<LeaderboardDto, IComparable>> SortKeys = new()
    {
        ["Rank"] = r => r.Rank,
        ["Player"] = r => r.PlayerName,
        ["Score"] = r => r.Score,
        ["Max"] = r => r.MaxPossible,
        ["Correct"] = r => r.CorrectPicks,
        ["Tiebreaker"] = r => r.TieBreakerPoints,
        ["Bowls"] = r => r.RoundScores[TournamentRound.Standard],
        ["Round1"] = r => r.RoundScores[TournamentRound.Round1],
        ["QuarterFinal"] = r => r.RoundScores[TournamentRound.QuarterFinal],
        ["SemiFinal"] = r => r.RoundScores[TournamentRound.SemiFinal],
        ["Championship"] = r => r.RoundScores[TournamentRound.Championship]
    };

    private static readonly HashSet<string> BiggestFirst = new() { "Score", "Max", "Correct", "Bowls", "Round1", "QuarterFinal", "SemiFinal", "Championship" };

    private void Sort(string column, bool forceToggle = true)
    {
        if (forceToggle)
        {
            if (sortColumn == column) isAscending = !isAscending;
            else
            {
                sortColumn = column;
                isAscending = !BiggestFirst.Contains(column);
            }
        }

        var key = SortKeys[column];
        leaderboard = isAscending ? leaderboard.OrderBy(key).ToList() : leaderboard.OrderByDescending(key).ToList();
    }

    private string RowLabel(LeaderboardDto row) =>
        picksHidden
            ? $"{row.PlayerName}, rank {row.Rank}, {row.Score} points"
            : $"{row.PlayerName}, rank {row.Rank}, {row.Score} points, up to {row.MaxPossible} possible. Open this entry's picks.";

    private static string TrophyColor(int rank) => rank switch { 1 => "#D4A017", 2 => "#8A8F98", _ => "#A9682B" };
    private static string TrophyTitle(int rank) => rank switch { 1 => "1st place - Gold", 2 => "2nd place - Silver", _ => "3rd place - Bronze" };

    public void Dispose()
    {
        PoolSelection.Changed -= OnPoolSelectionChanged;
        PoolSelection.Clear();
    }
}
