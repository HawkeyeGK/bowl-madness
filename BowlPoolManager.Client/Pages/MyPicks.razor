@page "/mypicks"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core
@using BowlPoolManager.Core.Helpers
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json

@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject BowlPoolManager.Client.Services.AppState AppState
@inject BowlPoolManager.Client.Services.ISeasonService SeasonService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@using BowlPoolManager.Client.Components
@using MudBlazor
@using BowlPoolManager.Client.Helpers

@*
    Release 2 group C: My Picks and the entry editor, built from the shared components in Client/Ui.
    The pick rules are unchanged from Phase 1.1 (EntryPickRules in Core): a slot whose team is not known is disabled,
    changing a pick clears the later picks that depended on it and says which, and an incomplete entry can be saved
    until picks lock.
*@

@if (isLoading)
{
    <PageContainer>
        <PageHeader Title="My Picks" />
        <LoadingIndicator Text="Loading your picks..." />
    </PageContainer>
}
else if (viewMode == ViewMode.Dashboard)
{
    <PageContainer>
        <PageHeader Title="My Picks" Subtitle="@(string.IsNullOrEmpty(currentSeasonDisplay) ? null : $"Season {currentSeasonDisplay}")">
            <Actions>
                <SecondaryButton OnClick="OpenPrintBlank" Icon="@Icons.Material.Outlined.Print">Print blank form</SecondaryButton>
                @if (currentEntries.Any())
                {
                    <PrimaryButton Icon="@Icons.Material.Outlined.Add" OnClick="CreateAdditionalEntry">New Entry</PrimaryButton>
                }
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Notice Tone="NoticeTone.Error">@errorMessage</Notice>
        }

        @if (!currentEntries.Any())
        {
            <EmptyState Title="@($"Join the pool for {currentSeasonDisplay}")" Icon="@Icons.Material.Outlined.ConfirmationNumber">
                <ChildContent>You don't have an entry yet. Type the invite code you were given to start.</ChildContent>
                <Action>
                    <EditForm Model="@joinModel" OnValidSubmit="StartNewEntry">
                        <MudTextField @bind-Value="joinModel.InviteCode" Label="Invite code" Variant="Variant.Outlined" Immediate="true" />
                        <PrimaryButton ButtonType="ButtonType.Submit" FullWidth="true" Large="true">Join pool</PrimaryButton>
                    </EditForm>
                </Action>
            </EmptyState>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (var entry in currentEntries)
                {
                    var stats = GetEntryStats(entry);
                    var entryPool = pools.FirstOrDefault(p => p.Id == entry.PoolId);
                    var poolName = entryPool?.Name ?? "Unknown pool";
                    var entryLocked = entryPool != null && DateTime.UtcNow > entryPool.LockDate;
                    <MudItem xs="12" md="6" lg="4">
                        <Card Tone="CardTone.Outlined" Eyebrow="@poolName" Title="@entry.PlayerName">
                            <div>Points <strong>@stats.Score</strong> · Max <strong>@stats.MaxPossible</strong> · Correct <strong>@stats.CorrectPicks</strong></div>
                            <div class="bm-note">@(entryPool == null ? "" : StatusLineText.ForPool(DateTime.UtcNow, entryPool.LockDate, null, 0, 0))</div>
                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                <PrimaryButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditEntry(entry))">@(entryLocked ? "View picks" : "View / Edit")</PrimaryButton>
                                <SecondaryButton OnClick="@(() => OpenPrint(entry.Id))" Icon="@Icons.Material.Outlined.Print">Print my picks</SecondaryButton>
                                @if (!entryLocked)
                                {
                                    <SecondaryButton Icon="@Icons.Material.Outlined.DeleteOutline" IconOnly="true" OnClick="@(() => DeleteEntry(entry))">Delete this entry</SecondaryButton>
                                }
                            </MudStack>
                        </Card>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (pastEntries.Any())
        {
            <h2 class="bm-section-title">Past seasons</h2>
            <MudGrid Spacing="2">
                @foreach (var entry in pastEntries.OrderByDescending(e => e.SeasonId))
                {
                    var poolName = pools.FirstOrDefault(p => p.Id == entry.PoolId)?.Name ?? "Unknown pool";
                    <MudItem xs="12" md="6" lg="4">
                        <Card Tone="CardTone.Outlined" Eyebrow="@($"Season {(seasonNameMap.TryGetValue(entry.SeasonId, out var sName) ? sName : entry.SeasonId)}")" Title="@poolName">
                            <div>Bracket: <strong>@entry.PlayerName</strong> <Badge>Archived</Badge></div>
                            <div>
                                <SecondaryButton Href="@($"history/{entry.PoolId}")" Icon="@Icons.Material.Outlined.History">View pool archive</SecondaryButton>
                            </div>
                        </Card>
                    </MudItem>
                }
            </MudGrid>
        }
    </PageContainer>
}
else if (viewMode == ViewMode.Join)
{
    <PageContainer Narrow="true">
        <PageHeader Title="Join a pool" Subtitle="Type your invite code" />
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Notice Tone="NoticeTone.Error">@errorMessage</Notice>
        }
        <Card Tone="CardTone.Outlined">
            <EditForm Model="@joinModel" OnValidSubmit="StartNewEntry">
                <MudTextField @bind-Value="joinModel.InviteCode" Label="Invite code" Placeholder="For example BOWL2026" Variant="Variant.Outlined" Immediate="true" />
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-3">
                    <PrimaryButton ButtonType="ButtonType.Submit" Large="true">Continue</PrimaryButton>
                    <SecondaryButton OnClick="BackToDashboard" Large="true">Back</SecondaryButton>
                </MudStack>
            </EditForm>
        </Card>
    </PageContainer>
}
else
{
    @* --- EDITOR --- *@
    var poolGames = ValidGames;
    var picked = PickedCount(poolGames);
    var matchups = EntryPickRules.Resolve(allSeasonGames, activeEntry.Picks);
    var tieBreakerGame = allSeasonGames.FirstOrDefault(g => g.Id == EntryPool?.TieBreakerGameId);
    var tbText = tieBreakerGame != null
        ? $"Tiebreaker: total points in the {tieBreakerGame.BowlName} ({tieBreakerGame.TeamAway} and {tieBreakerGame.TeamHome})"
        : "Tiebreaker: total points";

    <PageContainer>
        <PageHeader Title="@(string.IsNullOrWhiteSpace(activeEntry.PlayerName) ? "New entry" : activeEntry.PlayerName)"
                    Subtitle="@EntryPool?.Name"
                    Status="@EditorStatus"
                    StatusTone="@(IsEntryLocked ? StatusTone.Alert : StatusTone.Normal)"
                    StatusIcon="@(IsEntryLocked ? Icons.Material.Outlined.Lock : Icons.Material.Outlined.Schedule)">
            <Actions>
                <SecondaryButton Icon="@Icons.Material.Outlined.ArrowBack" OnClick="BackToDashboard">Back</SecondaryButton>
                @if (!string.IsNullOrEmpty(activeEntry.Id))
                {
                    <SecondaryButton OnClick="@(() => OpenPrint(activeEntry.Id))" Icon="@Icons.Material.Outlined.Print">Print my picks</SecondaryButton>
                }
            </Actions>
        </PageHeader>

        <EditForm Model="@activeEntry" OnValidSubmit="SavePicks" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <Notice Tone="NoticeTone.Error">@errorMessage</Notice>
            }

            <Card Tone="CardTone.Outlined" Title="Bracket name">
                <MudTextField @bind-Value="activeEntry.PlayerName" For="@(() => activeEntry.PlayerName)" Disabled="@(!CanEditName)"
                              Label="Bracket name" Placeholder="Give this bracket a unique name" Variant="Variant.Outlined" Immediate="true" />
                @if (IsEntryLocked && CanEditName)
                {
                    <div><PrimaryButton ButtonType="ButtonType.Submit" Disabled="@isSaving" Icon="@Icons.Material.Outlined.Save">Save name</PrimaryButton></div>
                }
            </Card>

            <Card Tone="CardTone.Outlined">
                <PickProgress Picked="@picked" Total="@poolGames.Count" />
            </Card>

            @if (!string.IsNullOrEmpty(clearNotice))
            {
                <Notice Tone="NoticeTone.Warning">
                    @clearNotice
                    <div><SecondaryButton OnClick="DismissClearNotice">Got it</SecondaryButton></div>
                </Notice>
            }

            <MudGrid Spacing="2">
                @{ bool? lastWasPlayoff = null; }
                @foreach (var game in GameOrder.ForEntry(poolGames))
                {
                    @if (lastWasPlayoff != game.IsPlayoff)
                    {
                        lastWasPlayoff = game.IsPlayoff;
                        <MudItem xs="12">
                            <h2 class="bm-section-title">@(game.IsPlayoff ? "Playoff games" : "Bowl games")</h2>
                            @if (!IsEntryLocked && !game.IsPlayoff)
                            {
                                <div class="bm-note">Tap the team you think will win.</div>
                            }
                        </MudItem>
                    }
                    var slots = matchups[game.Id];
                    var waiting = new[] { slots.HomeWaitsFor, slots.AwayWaitsFor }.Where(n => n != null).ToList();
                    string? hint = waiting.Any() ? $"Pick {string.Join(" and ", waiting)} first." : null;
                    string? pick = activeEntry.Picks != null && activeEntry.Picks.TryGetValue(game.Id, out var p) ? p : null;
                    var gameId = game.Id;
                    <MudItem xs="12" md="6">
                        <GamePickCard Game="@game" Slots="@slots" AllGames="@allSeasonGames" Pick="@pick"
                                      Locked="@IsEntryLocked" Cleared="@clearedGameIds.Contains(game.Id)"
                                      EliminatedTeams="@eliminatedTeams" Hint="@hint"
                                      OnPick="@((team) => UpdatePick(gameId, team))" />
                    </MudItem>
                }
            </MudGrid>

            <Card Tone="CardTone.Tint" Title="@tbText">
                <MudNumericField T="int" @bind-Value="activeEntry.TieBreakerPoints" Min="0" Max="999" Disabled="@IsEntryLocked"
                                 Label="Total points" Variant="Variant.Outlined" HideSpinButtons="true" />
            </Card>

            @if (!IsEntryLocked)
            {
                <StickySaveBar>
                    <PrimaryButton ButtonType="ButtonType.Submit" Large="true" FullWidth="true" Disabled="@isSaving" Icon="@Icons.Material.Outlined.Save">
                        @(isSaving ? "Saving..." : "Save my picks")
                    </PrimaryButton>
                    <div class="bm-note bm-note--center">You can save part-way and finish later, until the lock time.</div>
                </StickySaveBar>
            }

            <details>
                <summary>Change history</summary>
                @if (activeEntry.AuditLog != null && activeEntry.AuditLog.Any())
                {
                    <ul class="bm-note">
                        @foreach (var log in activeEntry.AuditLog.AsEnumerable().Reverse())
                        {
                            <li>@log</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="bm-note">No changes recorded.</div>
                }
            </details>
            </MudStack>
        </EditForm>
    </PageContainer>
}

@code {
    private enum ViewMode { Dashboard, Join, Editor }
    private ViewMode viewMode = ViewMode.Dashboard;

    private class JoinModel { public string InviteCode { get; set; } = ""; }
    private JoinModel joinModel = new();
    
    private bool isLoading = true;
    
    private bool isSaving = false;
    private string errorMessage = "";
    
    private List<BowlPool> pools = new();
    
    private List<BowlGame> allSeasonGames = new();
    
    // Dynamic Filter for Editor
    private List<BowlGame> ValidGames 
    {
        get 
        {
            if (viewMode != ViewMode.Editor) return new List<BowlGame>();
            
            BowlPool? targetPool = null;
            if (!string.IsNullOrEmpty(activeEntry.PoolId))
            {
                targetPool = pools.FirstOrDefault(p => p.Id == activeEntry.PoolId);
            }
            else if (!string.IsNullOrEmpty(joinModel.InviteCode))
            {
                // The code opens the current season's open pool (issue 135)
                targetPool = FindPoolByCode(joinModel.InviteCode);
            }
            
            if (targetPool != null && targetPool.GameIds != null && targetPool.GameIds.Any())
            {
                return allSeasonGames.Where(g => targetPool.GameIds.Contains(g.Id)).ToList();
            }
            
            // FALLBACK SAFETY: If we are in "New Entry" mode (have an invite code) but found no pool,
            // return NONE instead of ALL.
            if (!string.IsNullOrEmpty(joinModel.InviteCode) && string.IsNullOrEmpty(activeEntry.PoolId))
            {
                return new List<BowlGame>();
            }

            return allSeasonGames;
        }
    }
    
    private List<BracketEntry> myEntries = new();
    private List<BracketEntry> currentEntries = new();
    private List<BracketEntry> pastEntries = new();
    private BracketEntry activeEntry = new() { Picks = new Dictionary<string, string>() };

    private HashSet<string> eliminatedTeams = new(StringComparer.OrdinalIgnoreCase);

    private string currentSeasonId = "";
    private string currentSeasonDisplay = "";
    private Dictionary<string, string> seasonNameMap = new();
    
    // Helpers for Editor
    private BowlPool? EntryPool => pools.FirstOrDefault(p => p.Id == activeEntry.PoolId);
    private bool IsEntryLocked => EntryPool != null && DateTime.UtcNow > EntryPool.LockDate;
    private string EditorStatus => EntryPool == null ? "" : IsEntryLocked
        ? "Picks are locked. Everyone can now see everyone's picks."
        : StatusLineText.ForPool(DateTime.UtcNow, EntryPool.LockDate, null, 0, 0);
    private bool CanEditName => EntryPool == null || !EntryPool.IsConcluded;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            isLoading = true;
            
            // 0. Fetch Seasons (Dynamic Source of Truth)
            // Fetch seasons first to determine the current one
            var seasons = await SeasonService.GetSeasonsAsync();
            seasonNameMap = seasons.ToDictionary(s => s.Id, s => s.SeasonId); // GUID -> Year/Name
            var activeSeason = seasons.FirstOrDefault(s => s.IsCurrent) ?? seasons.OrderByDescending(s => s.Id).FirstOrDefault();
            
            if (activeSeason != null)
            {
                currentSeasonId = activeSeason.Id;
                currentSeasonDisplay = activeSeason.SeasonId;
            }
            
            // 1. Fetch Global Data
            // Fetch ALL pools and entries to support historical views
            var poolsTask = Http.GetFromJsonAsync<List<BowlPool>>("api/GetPools");
            // Games only for CURRENT season (for Editor)
            var gamesTask = Http.GetFromJsonAsync<List<BowlGame>>($"api/GetGames?seasonId={currentSeasonId}");
            var entriesTask = Http.GetFromJsonAsync<List<BracketEntry>>("api/GetMyEntries");
            
            await Task.WhenAll(poolsTask, gamesTask, entriesTask);
            
            pools = await poolsTask ?? new();
            allSeasonGames = await gamesTask ?? new();
            var allEntries = await entriesTask ?? new();
            
            // Separation of Church and State (Current vs Past)
            currentEntries = allEntries.Where(e => e.SeasonId == currentSeasonId).ToList();
            pastEntries = allEntries.Where(e => e.SeasonId != currentSeasonId).ToList();
            
            // Calculate Eliminated Teams
            eliminatedTeams = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var g in allSeasonGames.Where(x => x.IsFinal))
            {
                if (!string.IsNullOrEmpty(g.LosingTeamName))
                {
                    eliminatedTeams.Add(g.LosingTeamName);
                }
            }
            
            // Keep myEntries for delete logic or other ops?
            myEntries = allEntries;
            
            // Ensure Active Entry has instantiated Picks
            if (activeEntry.Picks == null) activeEntry.Picks = new Dictionary<string, string>();
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading data: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Codes are reused every year; a code that matches more than one pool opens the current season's pool (issue 135).
    private BowlPool? FindPoolByCode(string? code) =>
        InviteCodeLookup.Find(pools, code, new[] { currentSeasonId }, p => p.InviteCode, p => p.SeasonId, p => p.IsArchived);

    // Picks that lead to a playable game, out of the pool's games (issue 137).
    private int PickedCount(List<BowlGame> poolGames) =>
        EntryPickRules.CountValid(allSeasonGames, poolGames.Select(g => g.Id), activeEntry.Picks);

    private void CreateAdditionalEntry()
    {
        errorMessage = "";
        joinModel.InviteCode = "";
        viewMode = ViewMode.Join;
    }

    private void StartNewEntry()
    {
        if (string.IsNullOrWhiteSpace(joinModel.InviteCode))
        {
            TriggerToast("Please enter an invite code.", false);
            return;
        }

        // VALIDATION: Check if code corresponds to an valid, active pool
        var targetPool = FindPoolByCode(joinModel.InviteCode);

        if (targetPool == null)
        {
             TriggerToast("Invalid Invite Code. Please check and try again.", false);
             return;
        }

        if (DateTime.UtcNow > targetPool.LockDate)
        {
            TriggerToast("This pool is locked for new entries.", false);
            return;
        }

        activeEntry = new BracketEntry(); 
        activeEntry.Picks = new Dictionary<string, string>(); // Safe Init
        activeEntry.Id = "";
        activeEntry.PoolId = targetPool.Id; // Pre-set the Pool ID
        ResetClearNotice();

        viewMode = ViewMode.Editor;
    }

    private void EditEntry(BracketEntry entry)
    {
        // 1. Check for Archive
        var pool = pools.FirstOrDefault(p => p.Id == entry.PoolId);
        if (pool != null && pool.IsArchived)
        {
            Nav.NavigateTo($"history/{pool.Id}");
            return;
        }

        // Safe deep copy serialization
        activeEntry = System.Text.Json.JsonSerializer.Deserialize<BracketEntry>(
            System.Text.Json.JsonSerializer.Serialize(entry)
        ) ?? new BracketEntry();

        if (activeEntry.Picks == null) activeEntry.Picks = new Dictionary<string, string>();

        errorMessage = "";
        ResetClearNotice();

        // An entry saved before this check may hold picks that cannot be made; clear them here and say so (issue 128).
        // Not once the pool is locked: picks can no longer change then.
        bool poolLocked = pool != null && DateTime.UtcNow > pool.LockDate;
        if (!poolLocked)
        {
            var cleaned = EntryPickRules.ClearInvalid(allSeasonGames, activeEntry.Picks);
            if (cleaned.ClearedGameIds.Count > 0)
            {
                activeEntry.Picks = cleaned.Picks;
                MarkCleared(cleaned.ClearedGameIds,
                    $"Some saved picks no longer lead to a game you can pick, so they were cleared: {GameNames(cleaned.ClearedGameIds)}. Pick them again, then save.");
            }
        }

        viewMode = ViewMode.Editor;
    }

    private void BackToDashboard()
    {
        viewMode = ViewMode.Dashboard;
        errorMessage = "";
        ResetClearNotice();
    }

    // --- Cleared-pick notice (issue 128) ---
    private string clearNotice = "";
    private HashSet<string> clearedGameIds = new();

    private void ResetClearNotice()
    {
        clearNotice = "";
        clearedGameIds = new HashSet<string>();
    }

    private void DismissClearNotice() => clearNotice = "";

    private void MarkCleared(List<string> gameIds, string message)
    {
        clearedGameIds = new HashSet<string>(gameIds);
        clearNotice = message;
    }

    private string GameNames(IEnumerable<string> gameIds) =>
        string.Join(", ", gameIds.Select(id => allSeasonGames.FirstOrDefault(g => g.Id == id)?.BowlName ?? "a game"));

    private void UpdatePick(string gameId, string winner)
    {
        if (activeEntry.Picks == null) activeEntry.Picks = new Dictionary<string, string>();
        activeEntry.Picks[gameId] = winner;

        // A new pick can break picks in later games that built on the old one: clear them and say which (issue 128).
        var cleaned = EntryPickRules.ClearInvalid(allSeasonGames, activeEntry.Picks);
        activeEntry.Picks = cleaned.Picks;

        clearedGameIds.Remove(gameId);
        if (cleaned.ClearedGameIds.Count > 0)
        {
            var gameName = allSeasonGames.FirstOrDefault(g => g.Id == gameId)?.BowlName ?? "that game";
            MarkCleared(cleaned.ClearedGameIds,
                $"Changing your pick for {gameName} cleared your pick for {GameNames(cleaned.ClearedGameIds)}. Pick again.");
        }
        else
        {
            clearedGameIds.Remove(gameId);
            if (clearedGameIds.Count == 0) clearNotice = "";
        }
        StateHasChanged();
    }

    private void HandleInvalidSubmit()
    {
        TriggerToast("Please check the form for errors.", false);
    }

    private async Task DeleteEntry(BracketEntry entry)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the bracket '{entry.PlayerName}'? This action cannot be undone.");
        if (!confirmed) return;

        isSaving = true;
        try
        {
            var response = await Http.DeleteAsync($"api/DeleteEntry/{entry.Id}?seasonId={entry.SeasonId}");
            if (response.IsSuccessStatusCode)
            {
                myEntries.Remove(entry);
                if (entry.SeasonId == currentSeasonId)
                {
                    currentEntries.Remove(entry);
                }
                else
                {
                    pastEntries.Remove(entry);
                }
                TriggerToast("Bracket deleted successfully.", true);
                
                AppState.NotifyDataChanged();
                StateHasChanged();
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                TriggerToast($"Delete failed: {msg}", false);
            }
        }
        catch (Exception ex)
        {
            TriggerToast($"Error: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SavePicks()
    {
        // FIX: Ensure Picks is not null before LINQ query
        activeEntry.Picks ??= new Dictionary<string, string>();

        // Picks may be saved part-way before lock (BUSINESS-RULES section 3). Junk or stale picks are dropped first,
        // and only valid picks are counted for the "left" message. Locked pools keep their stored picks.
        int picksLeft = 0;
        if (!IsEntryLocked)
        {
            activeEntry.Picks = EntryPickRules.ClearInvalid(allSeasonGames, activeEntry.Picks).Picks;
            var poolGames = ValidGames;
            picksLeft = poolGames.Count - PickedCount(poolGames);
        }

        isSaving = true;
        errorMessage = "";

        try
        {
            string url = "api/CreateEntry?assignToMe=true";
            if (!string.IsNullOrEmpty(joinModel.InviteCode) && string.IsNullOrEmpty(activeEntry.PoolId))
            {
                activeEntry.Id = "";
                url += $"&inviteCode={joinModel.InviteCode}";
            }

            var response = await Http.PostAsJsonAsync(url, activeEntry);
            if (response.IsSuccessStatusCode)
            {
                var savedEntry = await response.Content.ReadFromJsonAsync<BracketEntry>();
                if (savedEntry != null)
                {
                    var targetList = (savedEntry.SeasonId == currentSeasonId) ? currentEntries : pastEntries;
                    var existingIndex = targetList.FindIndex(e => e.Id == savedEntry.Id);
                    
                    if (existingIndex >= 0)
                    {
                        targetList[existingIndex] = savedEntry;
                    }
                    else
                    {
                        targetList.Add(savedEntry);
                    }
                    
                    // Also keep master list in sync just in case
                    var masterIndex = myEntries.FindIndex(e => e.Id == savedEntry.Id);
                    if (masterIndex >= 0) myEntries[masterIndex] = savedEntry;
                    else myEntries.Add(savedEntry);
                    
                    TriggerToast(picksLeft > 0
                        ? $"Bracket saved. {picksLeft} {(picksLeft == 1 ? "pick" : "picks")} left to make before the deadline."
                        : "Bracket saved successfully!", true);
                    viewMode = ViewMode.Dashboard;
                    
                    AppState.NotifyDataChanged();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                TriggerToast("Name already taken.", false);
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed: {errorText}";
                TriggerToast($"Save failed: {errorText}", false);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private LeaderboardRow GetEntryStats(BracketEntry entry)
    {
        var rows = ScoringEngine.Calculate(allSeasonGames, new List<BracketEntry> { entry });
        return rows.FirstOrDefault() ?? new LeaderboardRow();
    }

    // The print page opens in a new tab so unsaved picks in the editor are not lost.
    private async Task OpenPrint(string entryId) =>
        await JS.InvokeVoidAsync("open", $"print-bracket/{entryId}", "_blank");

    // The blank entry form (group D builds it), for players who fill in picks on paper.
    private async Task OpenPrintBlank() =>
        await JS.InvokeVoidAsync("open", "print-bracket", "_blank");

    private void TriggerToast(string message, bool success) =>
        Snackbar.Add(message, success ? Severity.Success : Severity.Error);


}
