@page "/history/{poolId}"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Core.Helpers
@using BowlPoolManager.Client.Services
@using MudBlazor

@inject IPoolService PoolService
@inject NavigationManager Nav

@*
    Release 2 archive viewer: final standings as a shared DataTable; tap a name to see that entry's picks next to the results.
    An archive keeps names and scores only (no logos or AP ranks), so results are text rows, not game cards.
*@

<PageContainer>
    @if (isLoading)
    {
        <PageHeader Title="Pool History" />
        <LoadingIndicator Text="Loading the final standings..." />
    }
    else if (archive == null)
    {
        <PageHeader Title="Pool History" />
        <EmptyState Title="Archive not found" Icon="@Icons.Material.Outlined.SearchOff">
            <ChildContent>There is no archived record for this pool. It may not be archived yet.</ChildContent>
            <Action><PrimaryButton Href="leaderboard">Back to the Leaderboard</PrimaryButton></Action>
        </EmptyState>
    }
    else
    {
        <PageHeader Title="@archive.PoolName"
                    Subtitle="@($"Season {archive.Season} · final standings")"
                    Status="@($"Archived {DateTimeHelper.ToCentralLabel(archive.ArchivedOn, "MMM d, yyyy, h:mm tt")}")"
                    StatusIcon="@Icons.Material.Outlined.Archive">
            <Actions>
                <span class="bm-only-phone"><SecondaryButton Href="archives" Icon="@Icons.Material.Outlined.ArrowBack" IconOnly="true">Pool History</SecondaryButton></span>
                <span class="bm-only-wide"><SecondaryButton Href="archives" Icon="@Icons.Material.Outlined.ArrowBack">Pool History</SecondaryButton></span>
            </Actions>
        </PageHeader>

        <MudGrid Spacing="2">
            <MudItem xs="12" lg="6">
                <DataTable Label="Final standings">
                    <TableHeader Columns="@PhoneColumns" ColumnsWide="@WideColumns">
                        <TableHeaderCell Text="#" Hint="Rank" />
                        <TableHeaderCell Text="Name" />
                        <TableHeaderCell Text="Points" End="true" />
                        <TableHeaderCell Text="Tiebreaker" End="true" HidePhone="true" />
                    </TableHeader>
                    @foreach (var standing in archive.Standings.OrderBy(s => s.Rank).ThenBy(s => s.PlayerName))
                    {
                        var row = standing;
                        <TableRow Columns="@PhoneColumns" ColumnsWide="@WideColumns"
                                  State="@(selected == row ? RowState.Selected : RowState.Normal)"
                                  OnClick="@(() => Select(row))"
                                  AriaLabel="@($"{row.PlayerName}, rank {row.Rank}, {row.TotalPoints} points. Tap to see their picks.")">
                            <TableCell Kind="CellKind.Rank">@row.Rank</TableCell>
                            <TableCell Kind="CellKind.Name">
                                <span>@row.PlayerName</span>
                                @if (row.Rank is >= 1 and <= 3)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Style="@($"color: {TrophyColor(row.Rank)}")" Title="@TrophyTitle(row.Rank)" />
                                }
                            </TableCell>
                            <TableCell Kind="CellKind.Points">@row.TotalPoints</TableCell>
                            <TableCell Kind="CellKind.Muted" End="true" HidePhone="true">@row.TieBreakerPoints</TableCell>
                        </TableRow>
                    }
                </DataTable>
            </MudItem>

            <MudItem xs="12" lg="6">
                <div id="archive-results">
                    <Card Title="@(selected == null ? "Game results" : $"{selected.PlayerName}'s picks")">
                        @if (selected == null)
                        {
                            <div class="bm-note">Tap a name in the standings to see how that entry picked.</div>
                        }
                        <DataTable Label="Game results">
                            @* By kickoff: football archives keep no playoff round (BUSINESS-RULES section 2), so playoff games cannot be put last. *@
                            @foreach (var game in archive.Games.OrderBy(g => g.StartTime).ThenBy(g => g.GameId, StringComparer.Ordinal))
                            {
                                var winner = WinnerOf(game);
                                <TableRow Columns="minmax(0, 1fr) 56px">
                                    <TableCell Kind="CellKind.Text">
                                        <div><strong>@game.BowlName</strong></div>
                                        <div>@ResultText(game)</div>
                                        @if (selected != null)
                                        {
                                            @PickBadge(game, winner)
                                        }
                                    </TableCell>
                                    <TableCell Kind="CellKind.Muted" End="true">@game.PointValue @(game.PointValue == 1 ? "pt" : "pts")</TableCell>
                                </TableRow>
                            }
                        </DataTable>
                    </Card>
                </div>
            </MudItem>
        </MudGrid>
    }
</PageContainer>

@code {
    private const string PhoneColumns = "44px minmax(0, 1fr) 64px";
    private const string WideColumns = "56px minmax(160px, 1.6fr) 80px 104px";

    [Parameter]
    public string PoolId { get; set; } = string.Empty;

    private PoolArchive? archive;
    private bool isLoading = true;
    private ArchiveStanding? selected;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(PoolId))
            {
                archive = await PoolService.GetArchiveAsync(PoolId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading archive: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // A tap selects that entry; a second tap clears it. On a phone the picks sit below the standings, so jump to them.
    private void Select(ArchiveStanding standing)
    {
        if (selected == standing)
        {
            selected = null;
            return;
        }
        selected = standing;
        Nav.NavigateTo(Nav.Uri.Split('#')[0] + "#archive-results"); // same page, so the browser scrolls to it
    }

    private static string TrophyColor(int rank) => rank switch { 1 => "#D4A017", 2 => "#8A8F98", _ => "#A9682B" };
    private static string TrophyTitle(int rank) => rank switch { 1 => "1st place - Gold", 2 => "2nd place - Silver", _ => "3rd place - Bronze" };

    private static string ResultText(ArchiveGame game) =>
        game.TeamHomeScore.HasValue && game.TeamAwayScore.HasValue
            ? $"{game.TeamAway} {game.TeamAwayScore}, {game.TeamHome} {game.TeamHomeScore}"
            : $"{game.TeamAway} at {game.TeamHome}";

    // The winner, or "" when the archive has no decided result (a missing score or a tie).
    private static string WinnerOf(ArchiveGame game)
    {
        if (!game.TeamHomeScore.HasValue || !game.TeamAwayScore.HasValue) return "";
        if (game.TeamHomeScore > game.TeamAwayScore) return game.TeamHome;
        if (game.TeamAwayScore > game.TeamHomeScore) return game.TeamAway;
        return "";
    }

    private RenderFragment PickBadge(ArchiveGame game, string winner) => __builder =>
    {
        selected!.Picks.TryGetValue(game.GameId, out var pick);
        if (string.IsNullOrEmpty(pick))
        {
            <div><Badge>no pick</Badge></div>
        }
        else if (string.IsNullOrEmpty(winner))
        {
            <div>Picked @pick</div>
        }
        else if (string.Equals(pick, winner, StringComparison.OrdinalIgnoreCase))
        {
            <div><Badge Tone="BadgeTone.Good">right</Badge> Picked @pick</div>
        }
        else
        {
            <div><Badge Tone="BadgeTone.Alert">wrong</Badge> Picked @pick</div>
        }
    };
}
