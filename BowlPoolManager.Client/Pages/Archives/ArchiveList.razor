@page "/archives"
@using BowlPoolManager.Core.Domain
@using BowlPoolManager.Client.Services
@using MudBlazor

@inject IPoolService PoolService

@* Release 2: Pool History as shared Cards. Football only; the hoops history pages are Release 3. *@

<PageContainer>
    <PageHeader Title="Pool History" Subtitle="Final standings of past pools" />

    @if (isLoading)
    {
        <LoadingIndicator Text="Loading the past pools..." />
    }
    else if (!archivedPools.Any())
    {
        <EmptyState Title="No past pools yet" Icon="@Icons.Material.Outlined.History">
            <ChildContent>When a pool is finished and archived, its final standings and results are kept here.</ChildContent>
        </EmptyState>
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (var pool in archivedPools.OrderByDescending(p => p.Season).ThenBy(p => p.Name))
            {
                <MudItem xs="12" md="6" lg="4" @key="pool.Id">
                    <Card Tone="CardTone.Outlined" Eyebrow="@($"Season {pool.Season}")" Title="@pool.Name">
                        <span class="bm-note">Finished and archived. See the final standings and every result.</span>
                        <div><SecondaryButton Href="@($"history/{pool.Id}")" Icon="@Icons.Material.Outlined.EmojiEvents">View results</SecondaryButton></div>
                    </Card>
                </MudItem>
            }
        </MudGrid>
    }
</PageContainer>

@code {
    private List<BowlPool> archivedPools = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allPools = await PoolService.GetPoolsAsync();
            archivedPools = allPools.Where(p => p.IsArchived).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading pools: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
